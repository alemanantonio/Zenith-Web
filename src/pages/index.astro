---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Veil from '../components/Veil.astro';
import Footer from '../components/Footer.astro';
import HelpChat from '../components/HelpChat.astro';
import Cta from '../components/Cta.astro';
import Illustration from '../components/Illustration.astro';
import HeroMark from '../components/HeroMark.astro';
import L from '../components/L.astro';
import { specialties } from '../data/specialties';

const title = { es: 'Zenith · Agencia de desarrollo de software', en: 'Zenith · Software development agency' };
const description = {
  es: 'Zenith es una agencia de desarrollo de software: páginas web, software a la medida, automatizaciones y microservicios que te ahorran tiempo y facilitan tus tareas.',
  en: 'Zenith is a software development agency: websites, custom software, automations and microservices that save you time and make your work easier.',
};
const words = (t: string) => t.trim().split(/\s+/).map((w) => `<span class="w">${w}</span>`).join(' ');
const statementEs = 'Software que resuelve lo que te frena: ahorra tiempo, facilita tus tareas y te hace ganar más.';
const statementEn = 'Software that removes what holds you back: saves you time, makes tasks easier and helps you earn more.';
const steps = [
  { n: '01', t: { es: 'Contacto', en: 'Contact' }, d: { es: 'Escríbenos y cuéntanos qué necesitas; te atendemos de 7:00 a 17:00, hora de la Ciudad de México.', en: 'Write to us and tell us what you need; we are available from 7:00 AM to 5:00 PM, Mexico City time.' } },
  { n: '02', t: { es: 'Propuesta', en: 'Proposal' }, d: { es: 'Te enviamos una propuesta con alcance y precio; este depende del tamaño del proyecto.', en: 'We send you a proposal with scope and price; the price depends on the size of the project.' } },
  { n: '03', t: { es: 'Desarrollo', en: 'Development' }, d: { es: 'Construimos tu software y siempre te entregamos avances durante todo el proceso.', en: 'We build your software and you always receive progress updates throughout the process.' } },
  { n: '04', t: { es: 'Entrega', en: 'Delivery' }, d: { es: 'Entregamos el proyecto listo para usar. El plazo depende del tamaño del proyecto.', en: 'We deliver the project ready to use. The timeline depends on the size of the project.' } },
];
const launchIncluded = [
  { es: 'Landing page con personalización básica para que funcione para tu negocio', en: 'Landing page with basic customization to work for your business' },
  { es: 'Hosting por un año', en: 'One year of hosting' },
  { es: 'Renovación del certificado SSL/HTTPS, escaneo de malware y cortafuegos WAF', en: 'SSL/HTTPS certificate renewal, malware scanning and WAF firewall' },
  { es: 'Auditoría de cuentas administradoras, eliminación de usuarios inactivos y actualización de contraseñas seguras', en: 'Admin account audit, removal of inactive users and secure password updates' },
  { es: 'Respaldos y recuperación', en: 'Backups and recovery' },
  { es: 'Auditoría SEO y actualización de información general', en: 'SEO audit and general information updates' },
  { es: 'Diseño adaptable a móviles', en: 'Mobile-responsive design' },
  { es: 'El negocio proporciona la información y las fotografías', en: 'The business provides the information and photos' },
];
const launchExcluded = [
  { es: 'Sistemas complejos o administrativos', en: 'Complex or administrative systems' },
  { es: 'Páginas que no sean landing pages', en: 'Pages that are not landing pages' },
  { es: 'Dominio propio, correos empresariales y extras fuera del alcance', en: 'Custom domain, business email and extras outside the scope' },
  { es: 'Mantenimiento después del primer año', en: 'Maintenance after the first year' },
];
---
<Base title={title} description={description}>
  <Nav variant="home" />
  <Veil />

  <header class="hero" id="top">
    <div class="orb o1"></div><div class="orb o2"></div>
    <div class="ring"></div><div class="ring" style="animation-delay:2.5s"></div>
    <div class="glow"></div>
    <div class="stage">
      <div id="par"><div class="mark-wrap">
        <HeroMark /></div></div>
      <h1 class="word" aria-label="Zenith"><span class="words"><span style="--i:0">Z</span><span style="--i:1">E</span><span style="--i:2">N</span><span style="--i:3">I</span><span style="--i:4">T</span><span style="--i:5">H</span></span></h1>
      <p class="tag"><L es="Agencia de desarrollo de software. Tu negocio, con menos trabajo manual." en="Software development agency. Your business, with less manual work." /></p>
    </div>
    <div class="cue"></div>
  </header>

  <section class="statement" id="que-es">
    <p>
      <span class="l es" lang="es" set:html={words(statementEs)} />
      <span class="l en" lang="en" set:html={words(statementEn)} />
    </p>
  </section>

  <section class="services" id="soluciones"><div class="wrap">
    <h2 class="lm"><span><L es="Lo que resolvemos." en="What we solve." /></span></h2>
    <p class="lead rv"><L es="Somos una agencia de desarrollo de software. Resolvemos problemas reales: tiempo perdido, tareas repetitivas y datos esparcidos. Entra a cada área para ver cómo." en="We are a software development agency. We solve real problems: lost time, repetitive tasks and scattered data. Open each area to see how." /></p>
    <div class="exgrid">
      {specialties.map((s) => (
        <div class="exw rv"><a class="ex" href={`/${s.slug}`} aria-label={s.es.name}>
          <div class="art"><Illustration type={s.art} /></div>
          <div class="meta"><div><h3><L es={s.es.name} en={s.en.name} /></h3><p><L es={s.es.tag} en={s.en.tag} /></p></div><span class="go"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
        </a></div>
      ))}
    </div>
    <p class="note"><L es="Ejemplos ilustrativos." en="Illustrative examples." /></p>
  </div></section>

  <section class="principles" id="principios"><div class="wrap">
    <h2 class="lm"><span><L es="Para quien programa y para quien no." en="For those who code and those who don't." /></span></h2>
    <div class="pgrid">
      <div class="pr rv"><h3><L es="De principio a fin" en="End to end" /></h3><p><L es="Del diseño de la interfaz a la lógica y los datos que la sostienen." en="From interface design to the logic and data behind it." /></p></div>
      <div class="pr rv"><h3><L es="Productos open source" en="Open source products" /></h3><p><L es="Puedes usar el código de nuestros productos y alojarlos por tu cuenta. Si programas, puedes adaptarlos." en="You can use our products' code and host them yourself. If you code, you can adapt them." /></p></div>
      <div class="pr rv"><h3><L es="A tu medida, sin programar" en="Custom-built, no coding" /></h3><p><L es="¿Quieres una versión adaptada a tu negocio? Nosotros la personalizamos, alojamos y mantenemos." en="Want a version tailored to your business? We customize, host and maintain it." /></p></div>
    </div>
  </div></section>

  <section class="principles" id="proceso"><div class="wrap">
    <h2 class="lm"><span><L es="Cómo trabajamos." en="How we work." /></span></h2>
    <div class="pgrid proc">
      {steps.map((s) => (
        <div class="pr rv"><span class="num">{s.n}</span><h3><L es={s.t.es} en={s.t.en} /></h3><p><L es={s.d.es} en={s.d.en} /></p></div>
      ))}
    </div>
  </div></section>

  <section class="launch" id="lanzamiento"><div class="wrap">
    <h2 class="lm"><span><L es="Programa de Lanzamiento." en="Launch Program." /></span></h2>
    <div class="lswrap rv">
      <span class="lbadge"><i></i><L es="10 plazas · 2 ocupadas · 8 disponibles" en="10 spots · 2 taken · 8 available" /></span>
      <p class="lprice"><span class="amt">$0</span><span class="per"><L es="MXN · diseño, programación y hosting" en="MXN · design, development and hosting" /></span></p>
      <p class="llead"><L es="Para negocios que todavía no tienen página web. Incluye una landing page con personalización básica, hosting y mantenimiento durante un año. No incluye dominio propio ni correo empresarial. Después del primer año, solo pagas mantenimiento si quieres conservarla." en="For businesses that do not have a website yet. Includes a landing page with basic customization, hosting and maintenance for one year. Custom domain and business email are not included. After the first year, you only pay maintenance if you want to keep it." /></p>
      <a class="launch-apply" href="mailto:info@getzenith.dev?subject=Aplicación%20al%20Programa%20de%20Lanzamiento"><L es="Aplicar al programa" en="Apply to the program" /><span>→</span></a>
    </div>
    <div class="lcols">
      <div class="lcol inc rv">
        <h3><span class="ic"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><L es="Incluido sin costo" en="Included at no cost" /></h3>
        <ul>
          {launchIncluded.map((x) => (
            <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><L es={x.es} en={x.en} /></li>
          ))}
        </ul>
      </div>
      <div class="lcol exc rv">
        <h3><span class="ic"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><L es="Fuera de la promoción" en="Not included in the promotion" /></h3>
        <ul>
          {launchExcluded.map((x) => (
            <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><L es={x.es} en={x.en} /></li>
          ))}
        </ul>
      </div>
    </div>
  </div></section>

  <Cta heading={{ es: 'Hablemos de tu proyecto.', en: "Let's talk about your project." }} />

  <Footer />
  <HelpChat />
</Base>
