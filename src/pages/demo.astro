---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { site } from '../data/site';
---

<Base
  title={`Demo Interactivo · ${site.name}`}
  description="Explora un dashboard de muestra con estética Apple, almacenamiento, tareas y reproductor."
>
  <!-- Pantalla 1: Acceso / Login Estilo Apple (Glassmorphism sobrio, sin emojis) -->
  <div id="login-screen" class="login-layer">
    <div class="login-panel">
      <div class="login-brand">
        <Logo class="login-mark" />
        <span>{site.name.toUpperCase()}</span>
      </div>

      <div class="login-header">
        <span class="sub-pill" data-i18n="demoPage.loginBadge">Demo Interactiva</span>
        <h2 data-i18n="demoPage.loginTitle">Tu espacio personal</h2>
        <p data-i18n="demoPage.loginHint">Introduce tu nombre para personalizar tu dashboard en este dispositivo.</p>
      </div>

      <form id="login-form" class="login-form">
        <div class="field">
          <label for="username-input" data-i18n="demoPage.userInputLabel">Nombre o alias</label>
          <input
            type="text"
            id="username-input"
            name="username"
            data-i18n-attr="placeholder:demoPage.userInputPlaceholder"
            placeholder="Tu nombre"
            autocomplete="name"
            required
            maxlength="24"
          />
        </div>

        <button type="submit" class="apple-btn primary">
          <span data-i18n="demoPage.enterBtn">Entrar al panel</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h12m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>

      <a href="/" class="ghost-back" data-i18n="demoPage.backLink">Volver al inicio</a>
    </div>
  </div>

  <!-- Pantalla 2: Dashboard Minimalista Apple (Cards con 30px radius, SVG monocromático, microinteracciones) -->
  <div id="dashboard-app" class="dashboard-shell" style="display: none;">
    <!-- Barra Superior / Header de Sistema -->
    <header class="app-bar">
      <div class="bar-content">
        <div class="bar-leading">
          <a href="/" class="brand-link" aria-label="Zenith home">
            <Logo class="app-mark" />
            <span class="brand-text">ZENITH</span>
          </a>
          <span class="bar-sep" aria-hidden="true">/</span>
          <div class="user-greeting">
            <span class="greeting-prefix" data-i18n="demoPage.welcome">Bienvenido</span>
            <span id="display-username" class="greeting-name">Usuario</span>
          </div>
        </div>

        <div class="bar-trailing">
          <div class="status-chip">
            <span class="pulse-dot"></span>
            <span data-i18n="demoPage.tag">Espacio activo</span>
          </div>
          <LangSwitch />
          <button id="change-user-btn" class="apple-btn subtle" title="Cambiar perfil">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" fill="currentColor"/>
            </svg>
            <span class="hide-mobile" data-i18n="demoPage.changeUser">Cambiar perfil</span>
          </button>
          <a href="/" class="apple-btn subtle" title="Salir">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M15 10H5m0 0l4-4m-4 4l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="hide-mobile" data-i18n="demoPage.exitBtn">Salir</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="app-stage">
      <div class="stage-grid">
        <!-- Widget 1: Almacenamiento & Archivos (Limpio, estilo Finder / iCloud) -->
        <section class="apple-card widget-storage">
          <div class="card-title-row">
            <div class="title-left">
              <div class="card-icon">
                <!-- Icono SVG Cloud limpio -->
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M6.5 20a5 5 0 1 1 0-10 5.5 5.5 0 0 1 10.5 1.5A4.5 4.5 0 1 1 17.5 20H6.5Z"/>
                </svg>
              </div>
              <div>
                <h2 data-i18n="demoPage.driveTitle">Almacenamiento personal</h2>
                <p class="card-caption" data-i18n="demoPage.driveStorage">32.4 GB disponibles de 128 GB</p>
              </div>
            </div>
            <div class="title-right">
              <span class="badge-synced">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path fill="currentColor" d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
                <span data-i18n="demoPage.synced">Al día</span>
              </span>
            </div>
          </div>

          <!-- Barra de capacidad sutil -->
          <div class="storage-meter">
            <div class="meter-bar">
              <div class="meter-fill" style="width: 25.3%;"></div>
            </div>
          </div>

          <!-- Ruta / Migas de pan estilo macOS -->
          <div class="path-bar">
            <span class="path-segment" data-i18n="demoPage.rootFolder">Unidad local</span>
            <span class="path-chevron">›</span>
            <span class="path-segment current" data-i18n="demoPage.subFolder">Documentos & Proyectos</span>
          </div>

          <!-- Lista de Archivos Vectorial -->
          <div class="items-table">
            <div class="table-row">
              <div class="row-main">
                <span class="file-glyph folder">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 6a2 2 0 012-2h4l2 2h6a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
                </span>
                <span class="item-title" data-i18n="demoPage.folderPhotos">Fotografías 2026</span>
              </div>
              <span class="item-size">124 items</span>
              <span class="item-date" data-i18n="demoPage.timeToday">Hoy</span>
            </div>

            <div class="table-row">
              <div class="row-main">
                <span class="file-glyph folder">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 6a2 2 0 012-2h4l2 2h6a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
                </span>
                <span class="item-title" data-i18n="demoPage.folderBackups">Respaldos sistema</span>
              </div>
              <span class="item-size">4.8 GB</span>
              <span class="item-date" data-i18n="demoPage.timeYesterday">Ayer</span>
            </div>

            <div class="table-row">
              <div class="row-main">
                <span class="file-glyph doc">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 4v12a2 2 0 002 2h8a2 2 0 002-2V8l-4-4H6a2 2 0 00-2 2zm8 0v4h4"/></svg>
                </span>
                <span class="item-title" data-i18n="demoPage.fileFinances">Presupuesto_Personal.xlsx</span>
              </div>
              <span class="item-size">320 KB</span>
              <span class="item-date" data-i18n="demoPage.time3Days">3 días</span>
            </div>

            <div class="table-row">
              <div class="row-main">
                <span class="file-glyph pdf">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 4v12a2 2 0 002 2h8a2 2 0 002-2V8l-4-4H6a2 2 0 00-2 2zm8 0v4h4M7 13h6M7 10h3"/></svg>
                </span>
                <span class="item-title" data-i18n="demoPage.fileSpec">Arquitectura_Zenith.pdf</span>
              </div>
              <span class="item-size">1.4 MB</span>
              <span class="item-date" data-i18n="demoPage.time1Week">1 sem</span>
            </div>

            <div class="table-row">
              <div class="row-main">
                <span class="file-glyph audio">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V4a1 1 0 000-1z"/></svg>
                </span>
                <span class="item-title" data-i18n="demoPage.fileAudio">Starlight_Master.flac</span>
              </div>
              <span class="item-size">42 MB</span>
              <span class="item-date" data-i18n="demoPage.time2Weeks">2 sem</span>
            </div>
          </div>
        </section>

        <!-- Widget 2: Tareas con Animación Suave Apple -->
        <section class="apple-card widget-tasks">
          <div class="card-title-row">
            <div class="title-left">
              <div class="card-icon task-glyph">
                <!-- Icono Check circular -->
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 data-i18n="demoPage.tasksTitle">Tareas prioritarias</h2>
                <p class="card-caption" id="tasks-count-display">2 completadas de 4</p>
              </div>
            </div>
            <div class="title-right">
              <span class="time-tag" data-i18n="demoPage.todayTag">Hoy</span>
            </div>
          </div>

          <div class="task-deck" id="task-deck">
            <label class="task-row">
              <input type="checkbox" checked data-task-id="1" class="task-toggle" />
              <span class="apple-ring"><span class="ring-check"></span></span>
              <span class="task-text" data-i18n="demoPage.task1">Comprobar sincronización del almacenamiento local</span>
            </label>

            <label class="task-row">
              <input type="checkbox" checked data-task-id="2" class="task-toggle" />
              <span class="apple-ring"><span class="ring-check"></span></span>
              <span class="task-text" data-i18n="demoPage.task2">Organizar biblioteca de audio y listas nocturnas</span>
            </label>

            <label class="task-row">
              <input type="checkbox" data-task-id="3" class="task-toggle" />
              <span class="apple-ring"><span class="ring-check"></span></span>
              <span class="task-text" data-i18n="demoPage.task3">Anotar macros y metas del día</span>
            </label>

            <label class="task-row">
              <input type="checkbox" data-task-id="4" class="task-toggle" />
              <span class="apple-ring"><span class="ring-check"></span></span>
              <span class="task-text" data-i18n="demoPage.task4">Verificar enlace domótico de iluminación inteligente</span>
            </label>
          </div>

          <div class="hint-strip">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/>
              <path d="M8 5v3m0 3h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span data-i18n="demoPage.taskHint">Las tareas seleccionadas se conservan automáticamente en tu navegador.</span>
          </div>
        </section>
      </div>
    </main>

    <!-- Reproductor Inferior Flotante (Apple Music / macOS Docked Bar) -->
    <div class="now-playing-wrap">
      <footer class="player-dock">
        <!-- Izquierda: Portada y Track -->
        <div class="dock-track">
          <div class="album-art" id="album-disc">
            <div class="art-shimmer"></div>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#ffffff" d="M9 17H7a3 3 0 1 1 0-6h2V5.5l8-2V14h-2a3 3 0 1 1 0-6h2V5.38L9 7.13V17Z"/>
            </svg>
          </div>
          <div class="track-details">
            <span class="track-name" id="track-name">Starlight Reverie</span>
            <span class="track-meta" id="artist-name">Zenith Soundscapes · Ambient Chill</span>
          </div>
        </div>

        <!-- Centro: Controles de Transporte & Barra de Scrub -->
        <div class="dock-transport">
          <div class="transport-keys">
            <button class="transport-btn" id="btn-prev" title="Anterior" aria-label="Anterior">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>

            <button class="transport-btn main-play" id="btn-play-pause" title="Play / Pausa" aria-label="Play / Pausa">
              <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
              <svg class="icon-pause" style="display: none;" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>

            <button class="transport-btn" id="btn-next" title="Siguiente" aria-label="Siguiente">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
          </div>

          <div class="timeline-slider">
            <span class="stamp">1:42</span>
            <div class="time-track">
              <div class="time-fill" style="width: 48%;"></div>
              <div class="scrub-handle" style="left: 48%;"></div>
            </div>
            <span class="stamp">3:30</span>
          </div>
        </div>

        <!-- Derecha: Utilidades -->
        <div class="dock-utilities">
          <button class="util-btn" title="Cola" aria-label="Cola">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 4h16v2H2V4zm0 5h16v2H2V9zm0 5h11v2H2v-2z"/></svg>
            <span class="util-caption" data-i18n="demoPage.queue">Cola</span>
          </button>

          <div class="sound-slider" title="Volumen" aria-label="Volumen">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217zM14.657 5.343a1 1 0 011.414 0A7.973 7.973 0 0118 10a7.973 7.973 0 01-1.929 4.657 1 1 0 01-1.414-1.414A5.98 5.98 0 0016 10c0-1.285-.403-2.476-1.09-3.465a1 1 0 010-1.192z"/></svg>
            <div class="sound-track">
              <div class="sound-fill" style="width: 72%;"></div>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Base>

<script>
  import { translations, type Lang } from '../data/i18n';

  const USER_KEY = 'zenith_demo_user';
  const TASKS_KEY = 'zenith_demo_tasks';
  const PLAY_KEY = 'zenith_demo_playing';

  const loginScreen = document.getElementById('login-screen');
  const dashboardApp = document.getElementById('dashboard-app');
  const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
  const usernameInput = document.getElementById('username-input') as HTMLInputElement | null;
  const displayUsername = document.getElementById('display-username');
  const changeUserBtn = document.getElementById('change-user-btn');

  function initDemo() {
    const savedUser = localStorage.getItem(USER_KEY);
    if (savedUser && savedUser.trim()) {
      showDashboard(savedUser.trim());
    } else {
      showLogin();
    }
  }

  function showDashboard(username: string) {
    if (loginScreen && dashboardApp && displayUsername) {
      displayUsername.textContent = username;
      loginScreen.style.opacity = '0';
      loginScreen.style.transition = 'opacity 0.4s var(--ease), transform 0.4s var(--ease)';
      loginScreen.style.transform = 'scale(0.98)';

      setTimeout(() => {
        loginScreen.style.display = 'none';
        dashboardApp.style.display = 'flex';
        dashboardApp.style.opacity = '0';
        dashboardApp.style.transform = 'translateY(12px)';
        dashboardApp.style.transition = 'opacity 0.5s var(--ease), transform 0.5s var(--ease)';

        void dashboardApp.offsetWidth;
        dashboardApp.style.opacity = '1';
        dashboardApp.style.transform = 'none';

        loadSavedTasks();
        initPlayerSimulation();
      }, 350);
    }
  }

  function showLogin() {
    if (loginScreen && dashboardApp) {
      dashboardApp.style.opacity = '0';
      setTimeout(() => {
        dashboardApp.style.display = 'none';
        loginScreen.style.display = 'flex';
        void loginScreen.offsetWidth;
        loginScreen.style.opacity = '1';
        loginScreen.style.transform = 'none';
        if (usernameInput) {
          usernameInput.value = localStorage.getItem(USER_KEY) || '';
          usernameInput.focus();
        }
      }, 300);
    }
  }

  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = usernameInput?.value.trim() || 'Alex';
    localStorage.setItem(USER_KEY, val);
    showDashboard(val);
  });

  changeUserBtn?.addEventListener('click', () => {
    showLogin();
  });

  // Tareas con animación y persistencia
  function loadSavedTasks() {
    const saved = localStorage.getItem(TASKS_KEY);
    if (saved) {
      try {
        const state = JSON.parse(saved);
        document.querySelectorAll<HTMLInputElement>('.task-toggle').forEach((box) => {
          const id = box.getAttribute('data-task-id');
          if (id && state[id] !== undefined) {
            box.checked = Boolean(state[id]);
          }
        });
      } catch (e) {
        console.error(e);
      }
    }
    updateTasksCounter();
  }

  document.querySelectorAll<HTMLInputElement>('.task-toggle').forEach((box) => {
    box.addEventListener('change', () => {
      const state: Record<string, boolean> = {};
      document.querySelectorAll<HTMLInputElement>('.task-toggle').forEach((b) => {
        const id = b.getAttribute('data-task-id');
        if (id) {
          state[id] = b.checked;
        }
      });
      localStorage.setItem(TASKS_KEY, JSON.stringify(state));
      updateTasksCounter();
    });
  });

  function updateTasksCounter() {
    const all = document.querySelectorAll<HTMLInputElement>('.task-toggle');
    const checked = document.querySelectorAll<HTMLInputElement>('.task-toggle:checked');
    const display = document.getElementById('tasks-count-display');
    const lang = (document.documentElement.getAttribute('data-lang') as Lang) || 'es';
    const t = translations[lang].demoPage;

    if (display) {
      display.textContent = `${checked.length} ${t.tasksCountSuffix} ${t.tasksCountOf} ${all.length}`;
    }
  }

  // Reproductor simulado con pulso y estados
  function initPlayerSimulation() {
    const playPauseBtn = document.getElementById('btn-play-pause');
    const playIcon = playPauseBtn?.querySelector('.icon-play') as HTMLElement | null;
    const pauseIcon = playPauseBtn?.querySelector('.icon-pause') as HTMLElement | null;
    const disc = document.getElementById('album-disc');
    let isPlaying = localStorage.getItem(PLAY_KEY) === 'true';

    function renderPlayState() {
      if (!playIcon || !pauseIcon) return;
      if (isPlaying) {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
        disc?.classList.add('playing');
      } else {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
        disc?.classList.remove('playing');
      }
    }

    renderPlayState();

    playPauseBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      localStorage.setItem(PLAY_KEY, String(isPlaying));
      renderPlayState();
    });

    const tracks = [
      { name: 'Starlight Reverie', artist: 'Zenith Soundscapes · Ambient Chill' },
      { name: 'Midnight Focus Lo-Fi', artist: 'Nova Beats · Deep Work' },
      { name: 'Northern Aurora', artist: 'Nordic Echoes · Meditative' },
    ];
    let trackIdx = 0;

    const btnNext = document.getElementById('btn-next');
    const btnPrev = document.getElementById('btn-prev');
    const trackNameEl = document.getElementById('track-name');
    const artistNameEl = document.getElementById('artist-name');

    function animateTrackTransition(name: string, artist: string) {
      if (!trackNameEl || !artistNameEl) return;
      trackNameEl.style.opacity = '0';
      artistNameEl.style.opacity = '0';
      setTimeout(() => {
        trackNameEl.textContent = name;
        artistNameEl.textContent = artist;
        trackNameEl.style.opacity = '1';
        artistNameEl.style.opacity = '1';
      }, 160);
    }

    btnNext?.addEventListener('click', () => {
      trackIdx = (trackIdx + 1) % tracks.length;
      animateTrackTransition(tracks[trackIdx].name, tracks[trackIdx].artist);
    });

    btnPrev?.addEventListener('click', () => {
      trackIdx = (trackIdx - 1 + tracks.length) % tracks.length;
      animateTrackTransition(tracks[trackIdx].name, tracks[trackIdx].artist);
    });
  }

  // Observer para cambios de idioma en tiempo real
  const langObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-lang') {
        updateTasksCounter();
      }
    });
  });
  langObserver.observe(document.documentElement, { attributes: true });

  initDemo();
</script>

<style>
  /* ============================================================
     ESTÉTICA APPLE: Menos saturación, líneas ultra finas,
     esquinas amplias (28-32px), tipografía Jost, fondos limpios.
     ============================================================ */

  /* Login Minimalista */
  .login-layer {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: radial-gradient(circle at 50% 25%, rgba(162, 118, 184, 0.12), transparent 60%), var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .login-panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: clamp(36px, 5vw, 52px);
    width: 100%;
    max-width: 420px;
    box-shadow: 0 30px 60px -20px rgba(139, 86, 165, 0.2);
    text-align: center;
  }

  .login-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    letter-spacing: 0.28em;
    font-weight: 300;
    color: var(--ink);
    margin-bottom: 24px;
  }

  :global(.login-mark) {
    width: 22px;
    height: 22px;
    color: var(--p3);
  }

  .sub-pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--p3);
    background: color-mix(in srgb, var(--soft) 50%, transparent);
    border: 1px solid var(--line);
    margin-bottom: 12px;
  }

  .login-header h2 {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .login-header p {
    margin: 0 0 28px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--mute);
  }

  .field {
    text-align: left;
    margin-bottom: 22px;
  }

  .field label {
    display: block;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .field input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 18px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg) 60%, var(--card));
    border: 1px solid var(--line);
    color: var(--ink);
    -webkit-text-fill-color: var(--ink);
    opacity: 1;
    caret-color: var(--p3);
    font-family: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field input::placeholder {
    color: var(--mute);
    opacity: 1;
  }

  .field input:focus {
    border-color: var(--p3);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--p1) 25%, transparent);
  }

  /* Botones estilo Apple */
  .apple-btn {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 400;
    transition: transform 0.25s var(--ease), background 0.25s, box-shadow 0.25s;
  }

  .apple-btn svg {
    width: 15px;
    height: 15px;
  }

  .apple-btn.primary {
    width: 100%;
    background: var(--p3);
    color: #ffffff;
    box-shadow: 0 8px 22px -6px rgba(139, 86, 165, 0.5);
  }

  .apple-btn.primary:hover {
    background: var(--p1);
    transform: translateY(-1.5px);
  }

  .apple-btn.subtle {
    background: color-mix(in srgb, var(--card) 75%, transparent);
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 7px 15px;
    font-size: 13px;
  }

  .apple-btn.subtle:hover {
    border-color: var(--p1);
    color: var(--p3);
  }

  .ghost-back {
    display: inline-block;
    margin-top: 20px;
    font-size: 13px;
    color: var(--mute);
    transition: color 0.2s;
  }

  .ghost-back:hover {
    color: var(--ink);
  }

  /* ============================================================
     DASHBOARD SHELL
     ============================================================ */
  .dashboard-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-bottom: 100px;
  }

  .app-bar {
    height: 64px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar-content {
    max-width: 1140px;
    margin: 0 auto;
    height: 100%;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bar-leading {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }

  :global(.app-mark) {
    width: 20px;
    height: 20px;
    color: var(--p3);
  }

  .brand-text {
    font-size: 13px;
    letter-spacing: 0.24em;
    font-weight: 300;
  }

  .bar-sep {
    color: var(--line);
    font-weight: 300;
  }

  .user-greeting {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 14px;
  }

  .greeting-prefix {
    color: var(--mute);
    font-weight: 300;
  }

  .greeting-name {
    color: var(--ink);
    font-weight: 500;
  }

  .bar-trailing {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--mute);
    background: color-mix(in srgb, var(--card) 60%, transparent);
    border: 1px solid var(--line);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34c759;
    box-shadow: 0 0 8px #34c759;
  }

  /* Stage & Cards */
  .app-stage {
    flex: 1;
    max-width: 1140px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 44px) 24px;
  }

  .stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
  }

  .apple-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: clamp(24px, 3vw, 32px);
    box-shadow: 0 10px 28px -22px rgba(46, 34, 55, 0.18);
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }

  .apple-card:hover {
    box-shadow: 0 14px 34px -20px rgba(46, 34, 55, 0.2);
  }

  .card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .title-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--soft) 28%, transparent);
    color: var(--p3);
    display: grid;
    place-items: center;
  }

  .card-icon svg {
    width: 21px;
    height: 21px;
  }

  .card-icon.task-glyph {
    background: color-mix(in srgb, var(--p1) 16%, transparent);
  }

  .apple-card h2 {
    margin: 0 0 3px;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .card-caption {
    margin: 0;
    font-size: 13px;
    color: var(--mute);
  }

  .badge-synced {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: #34c759;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(52, 199, 89, 0.1);
  }

  .badge-synced svg {
    width: 12px;
    height: 12px;
  }

  .time-tag {
    font-size: 12px;
    color: var(--p3);
    font-weight: 500;
    padding: 0;
    letter-spacing: 0.02em;
  }

  /* Storage Meter & Path */
  .storage-meter {
    margin-bottom: 18px;
  }

  .meter-bar {
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line) 75%, transparent);
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--p3), var(--p1));
    transition: width 0.8s var(--ease);
  }

  .path-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    padding: 9px 14px;
    background: color-mix(in srgb, var(--card) 88%, var(--bg));
    border-radius: 12px;
    margin-bottom: 16px;
    color: var(--mute);
  }

  .path-segment.current {
    color: var(--ink);
    font-weight: 500;
  }

  .path-chevron {
    color: var(--line);
    font-size: 14px;
  }

  /* Table Rows */
  .items-table {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .table-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 13.5px;
    color: var(--ink);
    transition: background 0.2s var(--ease);
  }

  .table-row:hover {
    background: var(--mist);
  }

  .row-main {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .file-glyph {
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    color: var(--p3);
  }

  .file-glyph svg {
    width: 16px;
    height: 16px;
  }

  .file-glyph.folder svg {
    color: var(--p1);
  }

  .item-title {
    font-weight: 400;
  }

  .item-size {
    font-size: 12px;
    color: var(--mute);
    width: 80px;
    text-align: right;
  }

  .item-date {
    font-size: 12px;
    color: var(--mute);
    width: 70px;
    text-align: right;
  }

  /* Tasks Deck */
  .task-deck {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 20px;
  }

  .task-row {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 11px 14px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--card) 88%, var(--bg));
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .task-row:hover {
    border-color: var(--p1);
    transform: translateX(2px);
  }

  .task-toggle {
    display: none;
  }

  .apple-ring {
    width: 19px;
    height: 19px;
    border-radius: 50%;
    border: 1.8px solid var(--mute);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: all 0.25s var(--ease);
  }

  .ring-check {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffffff;
    opacity: 0;
    transform: scale(0.4);
    transition: all 0.25s var(--ease);
  }

  .task-toggle:checked + .apple-ring {
    background: var(--p3);
    border-color: var(--p3);
  }

  .task-toggle:checked + .apple-ring .ring-check {
    opacity: 1;
    transform: scale(1);
  }

  .task-text {
    font-size: 14px;
    color: color-mix(in srgb, var(--ink) 94%, transparent);
    font-weight: 400;
    line-height: 1.4;
    transition: color 0.25s, opacity 0.25s;
  }

  .task-toggle:checked ~ .task-text {
    text-decoration: line-through;
    color: var(--mute);
    opacity: 0.75;
  }

  .hint-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--mute);
    padding-top: 6px;
  }

  .hint-strip svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--p1);
  }

  /* ============================================================
     NOW PLAYING FLOTANTE (ESTILO APPLE MUSIC macOS)
     ============================================================ */
  .now-playing-wrap {
    position: fixed;
    bottom: 20px;
    left: 0;
    right: 0;
    z-index: 30;
    padding: 0 24px;
    pointer-events: none;
  }

  .player-dock {
    pointer-events: auto;
    max-width: 1040px;
    margin: 0 auto;
    height: 76px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--card) 85%, transparent);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    box-shadow: 0 20px 50px -15px rgba(46, 34, 55, 0.2);
    padding: 0 24px;
    display: grid;
    grid-template-columns: 280px 1fr 200px;
    align-items: center;
    gap: 24px;
  }

  .dock-track {
    display: flex;
    align-items: center;
    gap: 14px;
    overflow: hidden;
  }

  .album-art {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--p3), var(--p1));
    display: grid;
    place-items: center;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 12px -3px rgba(139, 86, 165, 0.4);
    transition: transform 0.4s var(--ease);
  }

  .album-art.playing {
    animation: gentlePulse 4s ease-in-out infinite alternate;
  }

  @keyframes gentlePulse {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }

  .album-art svg {
    width: 20px;
    height: 20px;
    display: block;
    margin: 0;
    transform: translateX(-1px);
  }

  .track-details {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .track-name {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    transition: opacity 0.16s ease;
  }

  .track-meta {
    font-size: 12px;
    color: var(--mute);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    transition: opacity 0.16s ease;
  }

  /* Transport Keys */
  .dock-transport {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .transport-keys {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .transport-btn {
    all: unset;
    cursor: pointer;
    color: var(--ink);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transition: transform 0.2s var(--ease), color 0.2s;
  }

  .transport-btn svg {
    width: 17px;
    height: 17px;
  }

  .transport-btn:hover {
    color: var(--p3);
    transform: scale(1.12);
  }

  .transport-btn.main-play {
    width: 36px;
    height: 36px;
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 4px 14px -3px rgba(46, 34, 55, 0.4);
  }

  .transport-btn.main-play svg {
    width: 18px;
    height: 18px;
  }

  .transport-btn.main-play:hover {
    background: var(--p3);
    color: #ffffff;
    transform: scale(1.08);
  }

  .timeline-slider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 420px;
  }

  .stamp {
    font-size: 11px;
    color: var(--mute);
    min-width: 26px;
  }

  .time-track {
    flex: 1;
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line) 80%, transparent);
    position: relative;
    cursor: pointer;
  }

  .time-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--ink);
  }

  .scrub-handle {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .time-track:hover .scrub-handle {
    opacity: 1;
  }

  /* Utilities */
  .dock-utilities {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .util-btn {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--mute);
    transition: color 0.2s;
  }

  .util-btn svg {
    width: 16px;
    height: 16px;
  }

  .util-btn:hover {
    color: var(--ink);
  }

  .sound-slider {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--mute);
  }

  .sound-slider svg {
    width: 16px;
    height: 16px;
  }

  .sound-track {
    width: 58px;
    height: 4px;
    background: color-mix(in srgb, var(--line) 80%, transparent);
    border-radius: 999px;
    overflow: hidden;
  }

  .sound-fill {
    height: 100%;
    background: var(--mute);
  }

  @media (max-width: 900px) {
    .stage-grid {
      grid-template-columns: 1fr;
    }

    .player-dock {
      grid-template-columns: 1fr auto;
    }

    .dock-utilities {
      display: none;
    }

    .hide-mobile {
      display: none;
    }

    .item-date {
      display: none;
    }
  }

  /* Apple-style refinement: calm materials, deliberate hierarchy, and soft motion. */
  .login-layer,
  .dashboard-shell {
    --bg: #f8f4fa;
    --card: rgba(255, 255, 255, 0.86);
    --ink: #2e2237;
    --mute: #7d6b88;
    --line: rgba(226, 209, 234, 0.9);
    --mist: rgba(248, 244, 250, 0.82);
    --p1: #a276b8;
    --p2: #b998c9;
    --p3: #8b56a5;
    --soft: #e2d1ea;
  }

  @media (prefers-color-scheme: dark) {
    .login-layer,
    .dashboard-shell {
      --bg: #1c1423;
      --card: rgba(37, 26, 45, 0.86);
      --ink: #f8f4fa;
      --mute: #b998c9;
      --line: rgba(53, 39, 63, 0.95);
      --mist: rgba(53, 39, 63, 0.68);
      --p1: #a276b8;
      --p2: #b998c9;
      --p3: #d3b8df;
      --soft: #35273f;
    }
  }

  .login-layer {
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8), transparent 45%),
      var(--bg);
  }

  .login-panel {
    background: var(--card);
    border-color: var(--line);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    animation: demoPanelIn 700ms var(--ease) both;
  }

  .sub-pill {
    color: var(--ink);
    background: var(--mist);
    border-color: var(--line);
  }

  .apple-btn.primary {
    background: var(--p3);
    color: #ffffff;
    box-shadow: 0 12px 24px rgba(139, 86, 165, 0.24);
  }

  .apple-btn.primary:hover {
    background: var(--p1);
    color: #ffffff;
  }

  .dashboard-shell {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--p2) 12%, transparent), transparent 32rem),
      var(--bg);
  }

  .dashboard-shell::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.22;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 18%, transparent) 0.5px, transparent 0.5px);
    background-size: 5px 5px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .app-bar {
    height: 72px;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom-color: var(--line);
  }

  .brand-text {
    font-weight: 500;
    letter-spacing: 0.2em;
  }

  .status-chip {
    background: var(--mist);
    border-color: var(--line);
  }

  .app-stage {
    padding-top: clamp(40px, 7vw, 76px);
    padding-bottom: 150px;
  }

  .stage-grid {
    gap: 18px;
  }

  .apple-card {
    border-color: var(--line);
    background: var(--card);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(22px) saturate(135%);
    -webkit-backdrop-filter: blur(22px) saturate(135%);
    animation: demoCardIn 700ms var(--ease) both;
  }

  .widget-storage {
    animation-delay: 90ms;
  }

  .widget-tasks {
    animation-delay: 170ms;
  }

  .apple-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
  }

  .card-title-row {
    margin-bottom: 26px;
  }

  .card-icon {
    background: var(--mist);
    color: var(--ink);
  }

  .card-icon.task-glyph {
    background: var(--mist);
  }

  .apple-card h2 {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .meter-fill {
    background: linear-gradient(90deg, var(--p3), var(--p1));
  }

  .path-bar,
  .task-row {
    background: var(--mist);
    border-color: transparent;
  }

  .path-bar {
    padding: 11px 14px;
  }

  .table-row {
    padding: 12px 10px;
  }

  .table-row:hover {
    background: var(--mist);
  }

  .task-deck {
    gap: 7px;
  }

  .task-row {
    min-height: 52px;
    transition: transform 350ms var(--ease), background 250ms ease, box-shadow 350ms var(--ease);
  }

  .task-row:hover {
    border-color: transparent;
    transform: translateX(4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .task-row:active {
    transform: scale(0.985);
  }

  .apple-ring {
    border-color: var(--p2);
  }

  .task-toggle:checked + .apple-ring {
    background: var(--p3);
    border-color: var(--p3);
  }

  .task-text {
    font-weight: 450;
  }

  .now-playing-wrap {
    bottom: 24px;
  }

  .player-dock {
    height: 82px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--card) 82%, transparent);
    border-color: var(--line);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.14);
    animation: demoDockIn 800ms 260ms var(--ease) both;
  }

  .album-art {
    border-radius: 13px;
    background: linear-gradient(135deg, var(--p3), var(--p1));
    box-shadow: 0 8px 20px rgba(139, 86, 165, 0.22);
  }

  .transport-btn.main-play {
    background: var(--p3);
    color: #ffffff;
  }

  .transport-btn.main-play:hover {
    background: var(--p1);
    color: #ffffff;
  }

  .time-fill,
  .scrub-handle {
    background: var(--p3);
