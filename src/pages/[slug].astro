---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Veil from '../components/Veil.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import Illustration from '../components/Illustration.astro';
import HelpChat from '../components/HelpChat.astro';
import L from '../components/L.astro';
import WebsiteExamples from '../components/WebsiteExamples.astro';
import HeroMark from '../components/HeroMark.astro';
import { specialties, type Specialty } from '../data/specialties';

export function getStaticPaths() {
  return specialties.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Specialty };
const others = specialties.filter((o) => o.slug !== s.slug);
const arrow = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const play = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5.4l7 4.6-7 4.6z" fill="currentColor"/></svg>';
const title = { es: `${s.es.name} · Zenith`, en: `${s.en.name} · Zenith` };
const description = { es: s.es.description, en: s.en.description };
const image = `/og-${s.slug}.svg`;
const words = (t: string) => t.trim().split(/\s+/).map((w) => `<span class="w">${w}</span>`).join(' ');
---
<Base title={title} description={description} image={image} service={{ es: s.es.name, en: s.en.name, description }}>
  <Nav variant="sub" />
  <Veil />

  <header class="hero sub">
    <div class="orb o1"></div><div class="orb o2"></div>
    <div class="ring"></div><div class="ring" style="animation-delay:2.5s"></div>
    <div class="glow"></div>
    <div class="stage">
      <div class="smark" aria-hidden="true"><HeroMark /></div>
      <p class="kicker"><L es="Especialidad" en="Specialty" /></p>
      <h1 class="word sub" aria-label={s.es.name}>
        <span class="words l es" lang="es">{s.es.name.split(' ').map((w, i) => <span style={`--i:${i}`}>{w}</span>)}</span>
        <span class="words l en" lang="en">{s.en.name.split(' ').map((w, i) => <span style={`--i:${i}`}>{w}</span>)}</span>
      </h1>
      <p class="tag"><L es={s.es.tag} en={s.en.tag} /></p>
    </div>
    <div class="cue"></div>
  </header>

  <section class="statement">
    <p>
      <span class="l es" lang="es" set:html={words(s.es.stmt)} />
      <span class="l en" lang="en" set:html={words(s.en.stmt)} />
    </p>
  </section>

  <section class="bigsec"><div class="wrap">
    <div class="bigart rv"><Illustration type={s.art} /></div>
    <p class="note"><L es="Ejemplo ilustrativo." en="Illustrative example." /></p>
  </div></section>

  {s.slug === 'paginas-web' && <WebsiteExamples />}

  <section class="principles"><div class="wrap">
    <h2 class="lm"><span><L es="Lo esencial." en="The essentials." /></span></h2>
    <div class="pgrid">
      {s.es.pr.map((p, i) => (
        <div class="pr rv"><h3><L es={p.t} en={s.en.pr[i].t} /></h3><p><L es={p.d} en={s.en.pr[i].d} /></p></div>
      ))}
    </div>
  </div></section>

  {s.products && s.products.length > 0 && (
    <section class="services" id="productos"><div class="wrap">
      <h2 class="lm"><span><L es="Ejemplos de software a medida." en="Custom software examples." /></span></h2>
      <p class="lead rv"><L es="Estas demos muestran posibilidades de un dashboard, un inventario o una plataforma SaaS. Tu proyecto se desarrolla según tus requisitos: primero analizamos lo que necesitas y acordamos alcance, precio y plazo. No son micro apps de acceso inmediato." en="These demos show what a dashboard, inventory system or SaaS platform could look like. Your project is built to your requirements: first we analyze your needs and agree on scope, price and timing. These are not micro apps with immediate access." /></p>
      <div class="exgrid">
        {s.products.map((p) => (
          <div class="exw rv"><div class="ex prod">
            <div class="art"><Illustration type={p.art} /></div>
            <div class="meta"><div><h3><L es={p.es.name} en={p.en.name} /></h3><p><L es={p.es.tag} en={p.en.tag} /></p></div></div>
            <div class="prod-foot">
              <strong><L es={p.es.startingPrice} en={p.en.startingPrice} /></strong>
              <div class="prod-links">
                {p.demo && <a class="pbtn" href={p.demo}><Fragment set:html={play} /><L es="Ver la demo" en="View the demo" /></a>}
              </div>
            </div>
          </div></div>
        ))}
      </div>
      <p class="note"><L es="Ejemplos ilustrativos." en="Illustrative examples." /></p>
    </div></section>
  )}

  <section class="principles" id="precio"><div class="wrap">
      <h2 class="lm"><span><L es="Precio del proyecto." en="Project pricing." /></span></h2>
    <div class="pgrid">
      {s.prices.map((p) => (
        <div class="pr price-card rv"><h3><L es={p.label.es} en={p.label.en} /></h3><strong><L es={p.amount.es} en={p.amount.en} /></strong>{p.note && <p><L es={p.note.es} en={p.note.en} /></p>}</div>
      ))}
      <div class="pr rv"><h3><L es="Plazo" en="Timeline" /></h3><p><L es="El plazo depende del tamaño del proyecto, pero siempre recibirás avances durante el desarrollo." en="The timeline depends on the size of the project, but you always receive progress updates during development." /></p></div>
      {!s.es.supportItems && <div class="pr rv"><h3><L es="Soporte" en="Support" /></h3><p><L es={s.es.support} en={s.en.support} /></p></div>}
    </div>
  </div></section>

  {s.es.supportItems && (
    <section class="principles support-detail"><div class="wrap">
      <h2 class="lm"><span><L es="Renovación anual." en="Annual renewal." /></span></h2>
      <p class="lead rv"><L es="Cada renovación incluye estos servicios para mantener tu página web protegida y actualizada:" en="Each renewal includes these services to keep your website protected and up to date:" /></p>
      <ul class="support-list">{s.es.supportItems.map((item, i) => <li><L es={item.es} en={s.en.supportItems?.[i]?.en ?? item.es} /></li>)}</ul>
    </div></section>
  )}

  <section class="others"><div class="wrap">
    <h2 class="lm"><span><L es="Otras especialidades." en="Other specialties." /></span></h2>
    <div class="mgrid">
      {others.map((o) => (
        <a class="mini rv" href={`/${o.slug}`}><span><L es={o.es.name} en={o.en.name} /></span><Fragment set:html={arrow} /></a>
      ))}
      <a class="mini rv" href="/micro-apps"><span><L es="Micro apps · Próximamente" en="Micro apps · Coming soon" /></span><span aria-hidden="true">→</span></a>
    </div>
  </div></section>

  <Cta heading={{ es: s.es.cta, en: s.en.cta }} />

  <Footer />
  <HelpChat />
</Base>
