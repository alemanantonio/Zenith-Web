---
// Demo generado a partir de Inventario.html — página independiente (sin layout del sitio).
import DemoI18n from '../../components/DemoI18n.astro';
import { demoI18n } from '../../data/demoI18n';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Zenith · Inventario (demo)</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style is:inline>
:root{--p1:#a276b8;--p2:#b998c9;--p3:#8b56a5;--soft:#e2d1ea;--mist:#f8f4fa;--bg:#f8f4fa;--ink:#2e2237;--mute:#7d6b88;--line:#e2d1ea;--card:#fff;--font:'Jost',ui-sans-serif,system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#1c1423;--ink:#f8f4fa;--mute:#b998c9;--line:#35273f;--card:#251a2d}}
:root[data-theme=dark]{--bg:#1c1423;--ink:#f8f4fa;--mute:#b998c9;--line:#35273f;--card:#251a2d}
*,*::before,*::after{box-sizing:border-box}[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 84px)}
body{margin:0;background:var(--bg);color:var(--ink);font:300 16px/1.5 var(--font);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--p3);outline-offset:3px;border-radius:8px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}.sec{padding:clamp(80px,12vw,150px) 0}
.rv{opacity:0;transform:translateY(28px);transition:opacity 1.1s var(--ease),transform 1.1s var(--ease)}.rv.in{opacity:1;transform:none}
.lm{overflow:hidden;padding-bottom:.12em}.lm>span{display:block;transform:translateY(110%);transition:transform 1.2s var(--ease)}.lm.in>span{transform:none}
.h2{margin:0;font-size:clamp(32px,5vw,56px);font-weight:200;letter-spacing:-.02em;line-height:1.1}.lead{margin:20px 0 0;max-width:48ch;font-size:clamp(17px,1.8vw,21px);line-height:1.55;color:var(--mute)}
.orb{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;animation:drift 18s ease-in-out infinite alternate;pointer-events:none}
@keyframes drift{to{transform:translate3d(6vmax,4vmax,0) scale(1.15)}}@keyframes fadein{from{opacity:0}}
@keyframes rise{from{opacity:0;transform:translateY(40%);filter:blur(10px)}to{opacity:1;transform:none;filter:none}}@keyframes up{from{opacity:0;transform:translateY(26px) scale(.98)}to{opacity:1;transform:none}}
@keyframes float{50%{transform:translate(8px,-10px)}}@keyframes spin{to{transform:rotate(360deg)}}
.grad{background:linear-gradient(135deg,#8b56a5,#a276b8 55%,#b998c9)}
.bt{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 28px;border-radius:999px;border:1px solid transparent;background:var(--p3);color:#fff;font-weight:400;font-size:16px;transition:transform .5s var(--ease),box-shadow .5s,border-color .3s}
.bt::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.4) 50%,transparent 65%);transform:translateX(-120%)}
.bt:hover{transform:translateY(-2px);box-shadow:0 16px 34px -14px rgba(139,86,165,.8)}.bt:hover::after{transform:translateX(120%);transition:transform .9s var(--ease)}
.bt.gh{background:transparent;color:var(--ink);border-color:var(--line)}.bt.gh:hover{border-color:var(--p1);box-shadow:none}.bt.lt{background:var(--mist);color:#5d3a73}
.nav{position:fixed;inset:0 0 auto 0;z-index:20;padding-top:env(safe-area-inset-top,0px);background:color-mix(in srgb,var(--bg) 62%,transparent);backdrop-filter:saturate(180%) blur(18px);-webkit-backdrop-filter:saturate(180%) blur(18px);animation:navin .9s var(--ease) .2s both}
@keyframes navin{from{transform:translateY(-100%)}}
.nav-in{max-width:1080px;margin:0 auto;height:56px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:10px;letter-spacing:.28em;font-size:14px}.brand svg{width:22px;height:22px;color:var(--p3)}
.links{display:flex;gap:26px;font-size:14px;color:var(--mute)}.links a:hover{color:var(--ink)}.nr{display:flex;gap:10px;align-items:center}.nr .bt{padding:8px 20px;font-size:14px}
.bar{position:absolute;left:0;bottom:0;height:1px;width:100%;background:var(--p1);transform:scaleX(var(--sp,0));transform-origin:left}
.ib{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:transparent;display:grid;place-items:center;transition:border-color .3s}.ib:hover{border-color:var(--p1)}.ib svg{width:18px;height:18px;transition:transform .6s var(--ease)}.ib:hover svg{transform:rotate(25deg)}
.ib.langb{font-size:12px;font-weight:500;letter-spacing:.05em}
.sp{position:relative}.sp::before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(320px circle at var(--mx,50%) var(--my,0%),rgba(162,118,184,.2),transparent 60%);opacity:0;transition:opacity .4s;pointer-events:none}.sp:hover::before{opacity:1}
.qa{border-top:1px solid var(--line)}.qa:last-child{border-bottom:1px solid var(--line)}
.qa button{all:unset;box-sizing:border-box;width:100%;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0;font-size:clamp(18px,2vw,22px);font-family:var(--font);transition:color .3s}.qa button:hover{color:var(--p3)}.qa button:focus-visible{outline:2px solid var(--p3);outline-offset:4px;border-radius:6px}
.qa i{position:relative;width:16px;height:16px;flex:none;transition:transform .6s var(--ease)}.qa i::before,.qa i::after{content:"";position:absolute;left:0;top:7.25px;width:16px;height:1.5px;background:currentColor}.qa i::after{transform:rotate(90deg)}.qa.open i{transform:rotate(135deg)}
.ans{display:grid;grid-template-rows:0fr;transition:grid-template-rows .7s var(--ease)}.qa.open .ans{grid-template-rows:1fr}.ans>div{overflow:hidden}
.ans p{margin:0;padding:0 0 26px;max-width:58ch;font-size:17px;line-height:1.6;color:var(--mute);opacity:0;transform:translateY(8px);transition:opacity .6s ease .1s,transform .6s var(--ease) .1s}.qa.open .ans p{opacity:1;transform:none}
#wl{display:flex;gap:10px;max-width:460px;margin:34px auto 0;padding:6px;border-radius:999px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.4)}
#wl input{flex:1;min-width:0;border:0;background:transparent;color:#fff;padding:0 18px;font:300 17px var(--font);outline:none}#wl input::placeholder{color:rgba(255,255,255,.75)}
#wl.sh{animation:shake .5s}@keyframes shake{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
#wl .bt svg{width:18px;height:18px;display:none}#wl.ok .bt svg{display:block}#wl.ok .bt svg path{stroke-dasharray:1;animation:dr .7s var(--ease) both}@keyframes dr{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
.wls{min-height:24px;margin:14px 0 0;font-size:15px;opacity:.9}
.cta{position:relative;overflow:hidden;text-align:center;color:#f8f4fa;padding:clamp(100px,14vw,170px) 24px}.cta .h2{position:relative;z-index:2}.cta .lead{margin:18px auto 0;color:inherit;opacity:.92;position:relative;z-index:2}
footer{display:flex;align-items:center;justify-content:center;gap:10px;padding:34px 24px;font-size:13px;color:var(--mute)}footer svg{width:18px;height:18px;color:var(--p1)}
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}::view-transition-old(root){z-index:1}::view-transition-new(root){z-index:2}
html.tt *,html.tt *::before,html.tt *::after{transition:background-color .6s ease,color .6s ease,border-color .6s ease!important}
.tsp{animation:tsp .8s var(--ease)}@keyframes tsp{from{transform:rotate(-140deg) scale(.3);opacity:0}}
@media(max-width:820px){.links{display:none}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.rv,.lm>span{opacity:1;transform:none}}

.login{position:fixed;inset:0;z-index:30;display:grid;place-items:center;overflow:hidden;color:#f8f4fa}
.login .glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(520px circle at var(--mx,50%) var(--my,45%),rgba(255,255,255,.22),transparent 60%)}
.lf{position:relative;z-index:2;width:min(92vw,380px);text-align:center}
.lf .lg{display:block;width:96px;height:96px;margin:0 auto 24px;animation:bloom 1.5s var(--ease) .1s both,spin 60s linear 1.7s infinite;filter:drop-shadow(0 10px 40px rgba(60,20,90,.35))}
@keyframes bloom{from{opacity:0;transform:scale(.3) rotate(-100deg);filter:blur(12px)}}
.lf>*:not(.lg){animation:up 1s var(--ease) both}.lf h1{margin:0 0 6px;font-weight:200;font-size:clamp(34px,7vw,46px);letter-spacing:-.02em;animation-delay:.5s}.lf p{margin:0;opacity:.9;animation-delay:.65s}
.fld{position:relative;margin:28px 0 14px;animation-delay:.8s!important}
.fld input{width:100%;padding:22px 22px 8px;border-radius:18px;border:1px solid rgba(255,255,255,.4);background:rgba(255,255,255,.14);color:#fff;font:400 18px var(--font);outline:none;backdrop-filter:blur(10px);transition:border-color .3s,background .3s,box-shadow .4s}
.fld input:focus{background:rgba(255,255,255,.22);border-color:#fff;box-shadow:0 0 0 6px rgba(255,255,255,.14)}
.fld label{position:absolute;left:23px;top:18px;font-size:17px;opacity:.85;pointer-events:none;transition:all .35s var(--ease)}
.fld input:focus+label,.fld input:not(:placeholder-shown)+label{top:8px;font-size:12px;letter-spacing:.08em}
.lf .bt{width:100%;animation-delay:.95s!important}.lf .hint{margin-top:16px;font-size:13px;opacity:.75;animation-delay:1.1s}.lf.sh{animation:shake .5s}
.app{display:grid;grid-template-columns:84px 1fr;min-height:100vh;position:relative}
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden}.bg .orb{opacity:.18}
.side{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;align-items:center;gap:8px;padding:22px 0;border-right:1px solid var(--line);background:color-mix(in srgb,var(--card) 70%,transparent);backdrop-filter:blur(14px)}
.side .lg{width:30px;height:30px;color:var(--p3);margin-bottom:18px}
.nv{position:relative;width:48px;height:48px;border-radius:16px;border:0;background:transparent;display:grid;place-items:center;color:var(--mute);transition:color .3s,background .3s}
.nv svg{width:22px;height:22px}.nv:hover{color:var(--ink)}.nv.on{color:var(--p3);background:color-mix(in srgb,var(--p1) 14%,transparent)}
.nv.on::before{content:"";position:absolute;left:-18px;top:12px;bottom:12px;width:3px;border-radius:3px;background:var(--p3);animation:gr .5s var(--ease)}@keyframes gr{from{transform:scaleY(0)}}
.side .out{margin-top:auto}
.main{padding:22px clamp(18px,3vw,36px) 70px;min-width:0}
.top{display:flex;align-items:center;gap:12px;justify-content:space-between}
.srch{position:relative;flex:0 1 300px;transition:flex-basis .5s var(--ease)}.srch:focus-within{flex-basis:380px}
.srch input{width:100%;height:42px;padding:0 16px 0 42px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:300 15px var(--font);outline:none;transition:box-shadow .4s,border-color .3s}
.srch svg{position:absolute;left:14px;top:12px;width:18px;height:18px;color:var(--mute)}.srch input:focus{border-color:var(--p1);box-shadow:0 0 0 5px color-mix(in srgb,var(--p1) 18%,transparent)}
.bell{position:relative}.bell i{position:absolute;top:8px;right:9px;width:8px;height:8px;border-radius:50%;background:var(--p3);border:2px solid var(--bg);transition:transform .4s}.bell.rd i{transform:scale(0)}
.bell.ring svg{animation:ringb .8s ease}@keyframes ringb{20%{transform:rotate(14deg)}40%{transform:rotate(-12deg)}60%{transform:rotate(8deg)}80%{transform:rotate(-4deg)}}
.av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:400;background:linear-gradient(135deg,var(--p3),var(--p2))}
.hello{margin:34px 0 4px;font-size:clamp(30px,4.6vw,48px);font-weight:200;letter-spacing:-.02em;line-height:1.15}
.hello span{display:inline-block;opacity:0}.live .hello span{animation:rise 1s var(--ease) both;animation-delay:calc(.4s + var(--i)*.03s)}
.sub{margin:0 0 26px;color:var(--mute)}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.w{grid-column:span 4;background:var(--card);border:1px solid var(--line);border-radius:24px;padding:22px;min-width:0;opacity:0;transition:box-shadow .5s,border-color .4s}
.live .w{animation:up .9s var(--ease) both;animation-delay:calc(.5s + var(--i)*.07s)}.w:hover{box-shadow:0 30px 60px -36px rgba(139,86,165,.55);border-color:var(--p2)}
.k{grid-column:span 3}.c8{grid-column:span 8}.c6{grid-column:span 6}
.w h3{margin:0;font-size:15px;font-weight:400;color:var(--mute)}.hd{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}
.num{font-size:clamp(28px,3vw,36px);font-weight:300;margin:10px 0 4px;letter-spacing:-.02em}
.dl{display:inline-block;font-size:13px;padding:2px 10px;border-radius:99px;background:color-mix(in srgb,var(--p1) 16%,transparent);color:var(--p3)}
.spk{display:block;width:100%;height:34px;margin-top:12px}
.ln{fill:none;stroke:var(--p3);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;vector-effect:non-scaling-stroke}.ar{fill:url(#ag)}
.tabs{display:flex;gap:4px;padding:4px;border-radius:99px;background:color-mix(in srgb,var(--p1) 12%,transparent)}.tabs button{border:0;background:transparent;padding:5px 12px;border-radius:99px;font-size:13px;color:var(--mute);transition:background .4s var(--ease),color .3s}.tabs button.on{background:var(--card);color:var(--p3);box-shadow:0 2px 8px rgba(139,86,165,.2)}
.cv{position:relative;height:210px}.cv svg{width:100%;height:100%;display:block;overflow:visible}.gl{stroke:var(--line);stroke-width:1}
.tp{position:absolute;pointer-events:none;padding:4px 10px;border-radius:10px;background:var(--ink);color:var(--bg);font-size:13px;transform:translate(-50%,-130%);opacity:0;transition:opacity .2s;white-space:nowrap}.cv:hover .tp{opacity:1}
.dt{fill:var(--p3);stroke:var(--card);stroke-width:3;opacity:0;transition:opacity .2s}.cv:hover .dt{opacity:1}
.dn{display:block;width:150px;height:150px;margin:0 auto;transform:rotate(-90deg)}.dn circle{fill:none;stroke-width:5;transition:stroke-dasharray 1.4s var(--ease)}
.dw{position:relative;width:150px;margin:0 auto}.dw b{position:absolute;inset:0;display:grid;place-items:center;font-weight:300;font-size:28px}
.lg2{display:flex;flex-wrap:wrap;gap:6px 14px;justify-content:center;margin-top:14px;font-size:13px;color:var(--mute)}.lg2 i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
.bs{display:flex;align-items:flex-end;gap:10px;height:150px}.bs div{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:flex-end;font-size:12px;color:var(--mute)}
.bs b{width:100%;border-radius:8px 8px 4px 4px;background:var(--p2);height:var(--h);transform:scaleY(0);transform-origin:bottom;transition:transform 1.1s var(--ease) calc(.9s + var(--k)*.08s),background .3s}.live .bs b{transform:scaleY(1)}.bs b:hover,.bs b.td{background:var(--p3)}
.tl{list-style:none;margin:0;padding:0;display:grid;gap:4px}.tl li{display:flex;align-items:center;gap:12px;padding:8px 0;animation:up .5s var(--ease) both}
.cb{width:24px;height:24px;border-radius:8px;border:1.5px solid var(--p2);background:transparent;display:grid;place-items:center;flex:none;transition:background .3s,border-color .3s}.cb svg{width:16px;height:16px}.cb path{fill:none;stroke:#fff;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .4s var(--ease)}
.dd .cb{background:var(--p3);border-color:var(--p3)}.dd .cb path{stroke-dashoffset:0}.tl span{flex:1;transition:color .3s,opacity .3s}.dd span{text-decoration:line-through;opacity:.55}
.rm{border:0;background:transparent;color:var(--mute);font-size:20px;opacity:0;transition:opacity .2s}.tl li:hover .rm{opacity:1}
.pg{height:6px;border-radius:6px;background:var(--soft);margin:14px 0;overflow:hidden}.pg i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--p3),var(--p2));border-radius:6px;transition:width .8s var(--ease)}
.add{width:100%;height:40px;padding:0 14px;border-radius:12px;border:1px dashed var(--p2);background:transparent;color:var(--ink);font:300 15px var(--font);outline:none;transition:border-color .3s,background .3s}.add:focus{border-style:solid;border-color:var(--p1);background:color-mix(in srgb,var(--p1) 6%,transparent)}
.cg{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center;font-size:14px}.cg b{font-weight:400;color:var(--mute);font-size:12px;padding:4px 0}.cg span{padding:7px 0;border-radius:10px;transition:background .3s}.cg span:hover{background:color-mix(in srgb,var(--p1) 16%,transparent)}.cg .td{background:var(--p3);color:#fff;animation:pls 2.4s infinite}
@keyframes pls{50%{box-shadow:0 0 0 6px rgba(162,118,184,.28)}}.cn{display:flex;gap:6px}.cn .ib{width:30px;height:30px}.cn svg{width:14px;height:14px}
.ac{list-style:none;margin:0;padding:0;display:grid;gap:14px}.ac li{display:flex;gap:12px;align-items:center}.ac i{width:10px;height:10px;border-radius:50%;background:var(--p1);flex:none;position:relative}.ac li:first-child i::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--p1);animation:pg2 2s infinite}@keyframes pg2{from{transform:scale(.6);opacity:1}to{transform:scale(1.8);opacity:0}}
.ac span{flex:1}.ac small{color:var(--mute)}
.nt{width:100%;height:150px;resize:none;border:0;border-radius:14px;padding:14px;background:color-mix(in srgb,var(--p1) 8%,transparent);color:var(--ink);font:300 16px/1.5 var(--font);outline:none;transition:box-shadow .3s}.nt:focus{box-shadow:0 0 0 3px color-mix(in srgb,var(--p1) 30%,transparent)}
.sv{font-size:13px;color:var(--p3);opacity:0;transition:opacity .4s}.sv.on{opacity:1}
@media(max-width:1100px){.k{grid-column:span 6}.c8,.w{grid-column:span 12}.c6{grid-column:span 12}}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{position:fixed;top:auto;bottom:0;left:0;right:0;height:64px;flex-direction:row;justify-content:space-around;padding:0 8px;border:0;border-top:1px solid var(--line);z-index:15}.side .lg,.side .out{display:none}.nv.on::before{display:none}.main{padding-bottom:100px}}
@media(max-width:560px){.k{grid-column:span 12}.srch{flex-basis:auto}}

.shell{display:grid;grid-template-columns:var(--sbw,256px) minmax(0,1fr);min-height:100vh;transition:grid-template-columns .5s var(--ease)}.shell.col{--sbw:76px}
.sb{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;border-right:1px solid var(--line);background:color-mix(in srgb,var(--card) 82%,transparent);backdrop-filter:blur(14px);padding:14px 12px;overflow:hidden;z-index:30;animation:sin 1s var(--ease) both}
@keyframes sin{from{transform:translateX(-100%)}}
.ws{display:flex;align-items:center;gap:10px;width:100%;padding:8px;border-radius:14px;border:1px solid var(--line);background:var(--card);text-align:left;transition:border-color .3s}.ws:hover{border-color:var(--p2)}.ws>svg{width:16px;height:16px;color:var(--mute);flex:none}
.wl{width:34px;height:34px;margin:0;padding:0;border:0;border-radius:10px;display:grid;place-items:center;flex:none;background:linear-gradient(135deg,var(--p3),var(--p2));color:#fff}.wl svg{width:20px;height:20px}
.wt{min-width:0;flex:1}.wt b{display:block;font-weight:400;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wt small{color:var(--mute);font-size:12px}
.sn{flex:1;overflow:auto;margin-top:14px;display:grid;align-content:start;gap:2px}.sl{margin:16px 10px 6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}.sl:first-child{margin-top:4px}
.si{position:relative;display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:12px;background:transparent;color:var(--mute);font-size:15px;text-align:left;white-space:nowrap;transition:background .3s,color .3s}.si svg{width:20px;height:20px;flex:none}
.si:hover{color:var(--ink);background:color-mix(in srgb,var(--p1) 10%,transparent)}.si.on{color:var(--p3);background:color-mix(in srgb,var(--p1) 16%,transparent)}.si.on::before{content:"";position:absolute;left:-12px;top:10px;bottom:10px;width:3px;border-radius:3px;background:var(--p3);animation:gr .5s var(--ease)}
