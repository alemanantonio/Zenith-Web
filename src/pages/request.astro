---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const capabilities = [
  {
    num: "01",
    tagKey: "requestPage.capabilities.0.tag",
    titleKey: "requestPage.capabilities.0.title",
    descKey: "requestPage.capabilities.0.desc",
    highlightKey: "requestPage.capabilities.0.highlight",
    tag: "Infrastructure & Storage",
    title: "Connect your personal or local cloud",
    desc: "Seamlessly connect with Google Drive, Dropbox, OneDrive, or private local storage (Nextcloud, TrueNAS, home server). Manage files through a clean interface styled exactly to your taste.",
    highlight: "Drive · Local Cloud · S3 Compatible"
  },
  {
    num: "02",
    tagKey: "requestPage.capabilities.1.tag",
    titleKey: "requestPage.capabilities.1.title",
    descKey: "requestPage.capabilities.1.desc",
    highlightKey: "requestPage.capabilities.1.highlight",
    tag: "Media Library",
    title: "Music, movies, readings, and collections",
    desc: "A unified entertainment center on your launchpad. Connect your personal media servers (Plex, Jellyfin, Spotify, Navidrome) or track books and movies with automated artwork.",
    highlight: "Personal Streaming · Books · Analytics"
  },
  {
    num: "03",
    tagKey: "requestPage.capabilities.2.tag",
    titleKey: "requestPage.capabilities.2.title",
    descKey: "requestPage.capabilities.2.desc",
    highlightKey: "requestPage.capabilities.2.highlight",
    tag: "Daily Productivity",
    title: "Task tracking, macros, and smart controls",
    desc: "Dedicated widgets for your daily routine: track nutritional macros, Pomodoro timers, priority tasks, and smart home automation (Home Assistant, lights, plugs, APIs).",
    highlight: "Fitness Macros · To-do · Smart Home IoT"
  },
  {
    num: "04",
    tagKey: "requestPage.capabilities.3.tag",
    titleKey: "requestPage.capabilities.3.title",
    descKey: "requestPage.capabilities.3.desc",
    highlightKey: "requestPage.capabilities.3.highlight",
    tag: "Web Ecosystem",
    title: "External web integrations & live data",
    desc: "Monitor real-time metrics, RSS feeds, server uptime, or embed everyday productivity tools directly into interactive cards without switching tabs.",
    highlight: "External APIs · Feeds · Embedded Cards"
  }
];
---

<Base
  title={`Custom Plan · ${site.name}`}
  description="Explore all custom integrations and managed hosting features for your Zenith dashboard."
  initialLang="en"
>
  <!-- Barra superior limpia -->
  <header class="top-bar">
    <div class="wrap bar-in">
      <a class="brand" href="/" aria-label="Back to home">
        <Logo class="nav-mark" />
        <span>{site.name.toUpperCase()}</span>
      </a>
      <div class="nav-actions">
        <LangSwitch />
        <a class="back-link" href="/">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M15 10H5m0 0l4-4m-4 4l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span data-i18n="nav.backToHome">Back to home</span>
        </a>
      </div>
    </div>
  </header>

  <main class="request-page">
    <!-- Hero / Presentación -->
    <section class="hero-custom">
      <div class="wrap">
        <span class="badge rv" data-i18n="requestPage.badge">Paid Plan · Hosted by Zenith</span>
        <h1 class="title lm">
          <span data-i18n="requestPage.title">Your dream dashboard. Without writing a single line of code.</span>
        </h1>
        <p class="lead rv" data-i18n="requestPage.lead">
          We handle infrastructure, meticulous aesthetic design, and custom integrations. If you can imagine it on your home screen, we build it for you.
        </p>
      </div>
    </section>

    <!-- Galería de lo que se puede agregar -->
    <section class="capabilities-section">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="lm"><span data-i18n="requestPage.secTitle">Everything we can build for you.</span></h2>
          <p class="rv" data-i18n="requestPage.secLead">
            Every panel is hand-crafted according to your daily habits. Here are a few popular integrations:
          </p>
        </div>

        <div class="cap-grid">
          {capabilities.map((cap) => (
            <div class="cap-card rv">
              <div class="card-top">
                <span class="num">{cap.num}</span>
                <span class="cap-tag" data-i18n={cap.tagKey}>{cap.tag}</span>
              </div>
              <h3 data-i18n={cap.titleKey}>{cap.title}</h3>
              <p data-i18n={cap.descKey}>{cap.desc}</p>
              <div class="cap-foot">
                <span class="highlight-pill" data-i18n={cap.highlightKey}>{cap.highlight}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Banner 'Pide lo que se te ocurra' -->
        <div class="freedom-banner rv">
          <div class="banner-content">
            <span class="wild-tag" data-i18n="requestPage.freedomTag">Total Freedom</span>
            <h3 data-i18n="requestPage.freedomTitle">Ask for whatever comes to your mind</h3>
            <p data-i18n="requestPage.freedomDesc">
              Have a personal finance spreadsheet? A Discord bot? Home IoT sensors or study habits? Tell us what you want to visualize and how you want it to feel. At Zenith, we build the exact experience you need.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Explicación de precios y presupuesto -->
    <section class="pricing-notice">
      <div class="wrap">
        <div class="pricing-box rv">
          <div class="price-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2M17 5l-5-3-5 3m10 14l-5 3-5-3" />
            </svg>
          </div>
          <div class="price-body">
            <h3 data-i18n="requestPage.priceTitle">About our pricing structure</h3>
            <p data-i18n="requestPage.priceDesc1">
              Because each dashboard is an artisanal piece of software, the final price is tailored based on your requirements, number of integrations, and technical complexity.
            </p>
            <p class="sub-price" data-i18n="requestPage.priceDesc2">
              Once we receive your request, we analyze the scope and deliver a clear, transparent proposal with zero surprises.
            </p>
          </div>
          <div class="price-action">
            <a class="contact-pill" href="mailto:info@antonioaleman.dev?subject=Zenith%20custom%20dashboard%20request">
              <span data-i18n="requestPage.priceBtn">Talk to the team</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .bar-in {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.28em;
    font-size: 14px;
    font-weight: 300;
  }

  :global(.nav-mark) {
    width: 22px;
    height: 22px;
    color: var(--p3);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--mute);
    transition: color 0.3s;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  /* Hero */
  .hero-custom {
    padding-top: clamp(60px, 10vw, 110px);
    padding-bottom: clamp(50px, 8vw, 90px);
    text-align: center;
    position: relative;
    background: linear-gradient(180deg, color-mix(in srgb, var(--soft) 25%, transparent) 0%, transparent 100%);
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    color: #fff;
    background: var(--p3);
    margin-bottom: 24px;
    box-shadow: 0 8px 24px -6px rgba(139, 86, 165, 0.4);
  }

  .title {
    margin: 0 auto 24px;
    max-width: 820px;
    font-size: clamp(36px, 5.8vw, 68px);
    font-weight: 200;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .lead {
    margin: 0 auto;
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.6;
    color: var(--mute);
    max-width: 58ch;
  }

  /* Capabilities Grid */
  .capabilities-section {
    padding: clamp(60px, 10vw, 120px) 0;
  }

  .sec-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(40px, 6vw, 64px);
  }

  .sec-head h2 {
    margin: 0 0 16px;
    font-size: clamp(32px, 4.5vw, 50px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .sec-head p {
    margin: 0;
    font-size: 17px;
    color: var(--mute);
    line-height: 1.6;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 32px;
  }

  .cap-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(28px, 4vw, 42px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    transition: transform 0.4s var(--ease), box-shadow 0.4s;
  }

  .cap-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 50px -20px rgba(139, 86, 165, 0.25);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .num {
    font-size: 28px;
    font-weight: 200;
    color: var(--p3);
    letter-spacing: -0.02em;
  }

  .cap-tag {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--p3);
    font-weight: 500;
    background: color-mix(in srgb, var(--soft) 40%, transparent);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .cap-card h3 {
    margin: 0;
    font-size: clamp(22px, 2.5vw, 26px);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .cap-card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--mute);
  }

  .cap-foot {
    margin-top: 10px;
  }

  .highlight-pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--soft) 35%, transparent);
    border: 1px solid color-mix(in srgb, var(--p1) 35%, var(--line));
    font-size: 13px;
    font-weight: 500;
    color: var(--p3);
  }

  /* Freedom Banner */
  .freedom-banner {
    border-radius: 30px;
    background: linear-gradient(135deg, #7c4496 0%, #8b56a5 50%, #9e6eb1 100%);
    color: #ffffff;
    padding: clamp(36px, 5vw, 56px);
    margin-top: 16px;
    box-shadow: 0 30px 60px -25px rgba(124, 68, 150, 0.5);
  }

  .banner-content {
    max-width: 68ch;
  }

  .wild-tag {
    display: inline-block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .freedom-banner h3 {
    margin: 0 0 14px;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .freedom-banner p {
    margin: 0;
    font-size: clamp(16px, 1.8vw, 18px);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.95);
  }

  /* Pricing notice */
  .pricing-notice {
    padding-bottom: clamp(70px, 12vw, 130px);
  }

  .pricing-box {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(28px, 4.5vw, 48px);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 32px;
  }

  .price-icon {
    width: 60px;
    height: 60px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--soft) 50%, transparent);
    color: var(--p3);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .price-icon svg {
    width: 30px;
    height: 30px;
  }

  .price-body h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
  }

  .price-body p {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--mute);
    max-width: 60ch;
  }

  .sub-price {
    font-size: 14px !important;
    opacity: 0.9;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--p3);
    color: #ffffff;
    padding: 15px 30px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 10px 24px -8px rgba(139, 86, 165, 0.5);
    transition: transform 0.3s var(--ease), box-shadow 0.3s, background 0.3s;
  }

  .contact-pill:hover {
    background: var(--p1);
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -10px rgba(139, 86, 165, 0.7);
  }

  .contact-pill svg {
    width: 17px;
    height: 17px;
  }

  @media (prefers-color-scheme: dark) {
    :global(.nav-mark),
    .back-link,
    .back-link:hover,
    .num,
    .cap-tag,
    .highlight-pill,
    .price-icon {
      color: #d3b8df;
    }

    .cap-tag {
      background: rgba(162, 118, 184, 0.22);
    }

    .highlight-pill {
      background: rgba(162, 118, 184, 0.18);
      border-color: rgba(185, 152, 201, 0.42);
    }

    .price-icon {
      background: rgba(162, 118, 184, 0.2);
    }
  }

  @media (max-width: 860px) {
    .cap-grid {
      grid-template-columns: 1fr;
    }
    .pricing-box {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }
</style>
