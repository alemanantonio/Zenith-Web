---
import '@fontsource-variable/jost';
---
<!DOCTYPE html>
<html lang="es" data-lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Página no encontrada · Zenith</title>
<meta name="description" content="La página que buscas no existe. Vuelve al inicio de Zenith.">
<meta name="theme-color" content="#8b56a5">
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<script is:inline>
try{
  var l=localStorage.getItem('zenith-lang');
  if(l!=='es'&&l!=='en'){
    l=(navigator.language||'').toLowerCase().indexOf('es')===0?'es':'en';
  }
  document.documentElement.setAttribute('data-lang',l);
  document.documentElement.setAttribute('lang',l);
}catch(e){}
</script>
<style is:global>
:root{
  --p1:#a276b8; --p3:#8b56a5; --soft:#e2d1ea; --mist:#f8f4fa;
  --bg:#f8f4fa; --ink:#2e2237; --mute:#7d6b88; --line:#e2d1ea;
  --font:'Jost Variable','Jost',ui-sans-serif,system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);
}
@media (prefers-color-scheme:dark){:root{--bg:#1c1423;--ink:#f8f4fa;--mute:#b998c9;--line:#35273f}}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100svh;display:grid;place-items:center;background:var(--bg);color:var(--ink);font-family:var(--font);font-weight:300;-webkit-font-smoothing:antialiased;text-align:center;padding:48px 24px}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--p3);outline-offset:4px;border-radius:6px}
.l.en{display:none}
html[data-lang="en"] .l.es{display:none}
html[data-lang="en"] .l.en{display:revert}
.mark{display:block;width:72px;height:72px;margin:0 auto 32px;animation:spin 40s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
h1{margin:0;font-weight:200;font-size:clamp(36px,7vw,64px);letter-spacing:-.02em;line-height:1.1}
p{margin:20px auto 0;max-width:38ch;font-size:clamp(17px,1.8vw,21px);line-height:1.55;color:var(--mute)}
.btn{display:inline-block;margin-top:40px;padding:15px 34px;border-radius:999px;background:var(--mist);color:#5d3a73;font-size:16px;font-weight:400;border:1px solid var(--line);transition:border-color .4s,box-shadow .5s}
@media (prefers-color-scheme:dark){:root .btn{background:#251a2d;color:var(--p1)}}
.btn:hover{border-color:var(--p1);box-shadow:0 18px 50px -18px rgba(139,86,165,.5)}
footer{margin-top:64px;font-size:13px;color:var(--mute)}
footer a{transition:color .3s}footer a:hover{color:var(--ink);text-decoration:underline}
.fsep{margin:0 8px;opacity:.5}
</style>
</head>
<body>
<main>
  <svg class="mark" viewBox="0 0 1000 1000" role="img" aria-label="Zenith"><image href="/favicon.svg" width="100%" height="100%"/></svg>
  <h1><span class="l es" lang="es">Página no encontrada.</span><span class="l en" lang="en">Page not found.</span></h1>
  <p><span class="l es" lang="es">La página que buscas no existe o cambió de dirección.</span><span class="l en" lang="en">The page you are looking for does not exist or has moved.</span></p>
  <a class="btn" href="/"><span class="l es" lang="es">Volver al inicio</span><span class="l en" lang="en">Back home</span></a>
  <footer>© 2026 Zenith<span class="fsep" aria-hidden="true">·</span><a href="/privacidad"><span class="l es" lang="es">Privacidad y aviso legal</span><span class="l en" lang="en">Privacy and legal notice</span></a></footer>
</main>
</body>
</html>
