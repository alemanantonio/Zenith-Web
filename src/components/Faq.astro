---
import { site } from '../data/site';
---
<section class="faq" id="preguntas">
  <div class="wrap">
    <h2 class="lm"><span data-i18n="faq.sectionTitle">Preguntas frecuentes.</span></h2>
    {site.faq.map((item, idx) => (
      <div class="qa rv">
        <button aria-expanded="false">
          <span data-i18n={`faq.items.${idx}.q`}>{item.q}</span>
          <i aria-hidden="true"></i>
        </button>
        <div class="ans">
          <div>
            <p data-i18n={`faq.items.${idx}.a`}>{item.a}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq {
    padding: 0 0 clamp(100px, 14vw, 180px);
  }

  .faq .wrap {
    max-width: 820px;
  }

  .faq h2 {
    margin: 0 0 40px;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .qa {
    border-top: 1px solid var(--line);
  }

  .qa:last-child {
    border-bottom: 1px solid var(--line);
  }

  .qa button {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 26px 0;
    font-size: clamp(18px, 2vw, 22px);
    font-family: var(--font);
    font-weight: 300;
    transition: color 0.3s;
  }

  .qa button:hover {
    color: var(--p3);
  }

  .qa button:focus-visible {
    outline: 2px solid var(--p3);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .qa i {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
    transition: transform 0.6s var(--ease);
  }

  .qa i::before,
  .qa i::after {
    content: "";
    position: absolute;
    left: 0;
    top: 7.25px;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }

  .qa i::after {
    transform: rotate(90deg);
  }

  :global(.qa.open) i {
    transform: rotate(135deg);
  }

  .ans {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease);
  }

  :global(.qa.open) .ans {
    grid-template-rows: 1fr;
  }

  .ans > div {
    overflow: hidden;
  }

  .ans p {
    margin: 0;
    padding: 0 0 28px;
    max-width: 58ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mute);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease 0.1s, transform 0.6s var(--ease) 0.1s;
  }

  :global(.qa.open) .ans p {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .qa i,
    .ans,
    .ans p {
      transition: none !important;
    }
  }
</style>
