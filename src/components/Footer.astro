---
import { INSTAGRAM, INSTAGRAM_USER, GITHUB, TIKTOK } from '../data/specialties';
import L from './L.astro';
---
<footer>
  <svg aria-hidden="true"><image href="/favicon.svg" width="100%" height="100%"/></svg>© 2026 Zenith
  <span class="fsep" aria-hidden="true">·</span>
  <L es="Atención 7:00–17:00 (CDMX)" en="Available 7:00 AM–5:00 PM (Mexico City)" />
  <span class="fsep" aria-hidden="true">·</span>
  <div class="footer-socials">
    <a href={INSTAGRAM} rel="noopener" aria-label={`Instagram @${INSTAGRAM_USER}`} title={`Instagram @${INSTAGRAM_USER}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href={GITHUB} rel="noopener" aria-label="GitHub @getzenithdev" title="GitHub @getzenithdev">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297a12 12 0 0 0-3.793 23.385c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.419-1.305.762-1.605-2.665-.303-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 6.006 0c2.291-1.552 3.297-1.23 3.297-1.23.654 1.652.243 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.625-5.479 5.922.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297Z"/></svg>
    </a>
    <a href={TIKTOK} rel="noopener" aria-label="TikTok @get_zenith" title="TikTok @get_zenith">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg>
    </a>
  </div>
  <span class="fsep" aria-hidden="true">·</span>
  <a href="/privacidad"><L es="Privacidad y aviso legal" en="Privacy and legal notice" /></a>
</footer>

<style>
  .footer-socials{display:flex;align-items:center;gap:4px}
  .footer-socials a{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%}
  .footer-socials svg{width:20px;height:20px;color:inherit}
  .footer-socials a:focus-visible{outline:2px solid currentColor;outline-offset:2px}
</style>
