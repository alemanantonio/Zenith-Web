---
import { site } from '../data/site';
---
<section class="principles" id="principios">
  <div class="wrap">
    <h2 class="lm"><span data-i18n="principles.sectionTitle">Pensado para ser tuyo.</span></h2>
    <div class="pgrid">
      {site.principles.map((pr, idx) => (
        <div class="pr rv">
          <h3 data-i18n={`principles.items.${idx}.title`}>{pr.title}</h3>
          <p data-i18n={`principles.items.${idx}.description`}>{pr.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .principles {
    padding: 0 0 clamp(100px, 14vw, 180px);
  }

  .principles h2 {
    margin: 0;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
    margin-top: 56px;
  }

  .pr {
    position: relative;
    padding-top: 26px;
  }

  .pr::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    width: 100%;
    background: var(--line);
  }

  .pr::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    width: 100%;
    background: var(--p1);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s var(--ease) 0.2s;
  }

  :global(.pr.in)::after {
    transform: scaleX(1);
  }

  .pr h3 {
    margin: 0 0 12px;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 300;
  }

  .pr p {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--mute);
  }

  @media (max-width: 820px) {
    .pgrid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr::after {
      transform: scaleX(1) !important;
      transition: none !important;
    }
  }
</style>
