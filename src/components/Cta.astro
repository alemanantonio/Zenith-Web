---
import { site } from '../data/site';
---
<section class="cta" id="contacto">
  <div class="orb o1" style="left:-20vmax;top:-20vmax"></div>
  <h2 class="lm"><span data-i18n="cta.title">Hablemos de tu panel.</span></h2>
  <p class="rv" data-i18n="cta.subtitle">Cuéntanos qué te gustaría ver en el tuyo.</p>
  <p class="contact-email rv">
    <span data-i18n="cta.emailLabel">Escríbenos a</span>
    <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
  </p>
  <div class="mag rv">
    <a class="btn" id="btn" href={site.links.contact} data-i18n="cta.button">Contáctanos</a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
    color: #f8f4fa;
    padding: clamp(110px, 16vw, 200px) 24px;
    background: linear-gradient(135deg, #8b56a5, #a276b8 55%, #b998c9);
  }

  .cta h2 {
    position: relative;
    z-index: 2;
    margin: 0;
    font-weight: 200;
    font-size: clamp(34px, 6.4vw, 76px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .cta p {
    position: relative;
    z-index: 2;
    margin: 20px auto 0;
    max-width: 36ch;
    font-size: clamp(17px, 1.8vw, 21px);
    opacity: 0.92;
  }

  .cta .contact-email {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    font-size: 15px;
    opacity: 0.94;
  }

  .contact-email a {
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mag {
    position: relative;
    z-index: 2;
    display: inline-block;
    margin-top: 44px;
  }

  .btn {
    display: inline-block;
    position: relative;
    overflow: hidden;
    padding: 15px 34px;
    border-radius: 999px;
    background: var(--mist);
    color: #5d3a73;
    font-size: 16px;
    font-weight: 400;
    transform: translate(var(--bx, 0), var(--by, 0));
    transition: transform 0.4s var(--ease), box-shadow 0.5s;
  }

  .btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(162, 118, 184, 0.35) 50%, transparent 65%);
    transform: translateX(-120%);
  }

  .btn:hover {
    box-shadow: 0 18px 50px -12px rgba(46, 34, 55, 0.55);
  }

  .btn:hover::after {
    transform: translateX(120%);
    transition: transform 0.9s var(--ease);
  }

  .cta .orb {
    opacity: 0.4;
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    width: 46vmax;
    height: 46vmax;
    background: #b998c9;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
