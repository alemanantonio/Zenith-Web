---
interface Props {
  kind: string;
  name: string;
  price: string;
  paid?: boolean;
  dataI18nKind?: string;
  dataI18nName?: string;
  dataI18nPrice?: string;
}

const {
  kind,
  name,
  price,
  paid = false,
  dataI18nKind,
  dataI18nName,
  dataI18nPrice,
} = Astro.props;
---
<article class:list={['plan', 'rv', { paid }]}>
  <div class="pi">
    <div>
      <span class="kind" data-i18n={dataI18nKind}>{kind}</span>
      <h3 data-i18n={dataI18nName}>{name}</h3>
      <slot />
    </div>
    <div class="foot">
      <span class="price" data-i18n={dataI18nPrice}>{price}</span>
      <div class="pbtns">
        <slot name="actions" />
      </div>
    </div>
  </div>
</article>

<style>
  .pi {
    height: 100%;
    border-radius: 28px;
    padding: clamp(28px, 4vw, 48px);
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    background: var(--card);
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s var(--ease), box-shadow 0.6s;
    will-change: transform;
  }

  .pi::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--gx, 50%) var(--gy, 0%), rgba(162, 118, 184, 0.22), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .pi:hover {
    box-shadow: 0 40px 70px -35px rgba(139, 86, 165, 0.55);
  }

  .pi:hover::before {
    opacity: 1;
  }

  .paid .pi {
    background: linear-gradient(145deg, #8b56a5, #a276b8 60%, #b998c9);
    color: #fff;
    border-color: transparent;
  }

  .paid .pi::before {
    background: radial-gradient(360px circle at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.28), transparent 60%);
  }

  .kind {
    font-size: 14px;
    color: var(--mute);
  }

  .paid .kind {
    color: rgba(255, 255, 255, 0.8);
  }

  .pi h3 {
    margin: 12px 0 16px;
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 200;
    letter-spacing: -0.02em;
  }

  :global(.pi p) {
    margin: 0 0 22px;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.5;
    max-width: 38ch;
    color: var(--mute);
  }

  .paid :global(.pi p) {
    color: rgba(255, 255, 255, 0.92);
  }

  :global(.pi ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 16px;
  }

  :global(.pi li) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  :global(.pi li svg) {
    width: 18px;
    height: 18px;
    flex: none;
  }

  :global(.pi li path) {
    fill: none;
    stroke: var(--p3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease) calc(0.5s + var(--k) * 0.15s);
  }

  .paid :global(.pi li path) {
    stroke: #fff;
  }

  :global(.in) :global(.pi li path),
  :global(.plan.in) :global(li path) {
    stroke-dashoffset: 0;
  }

  .price {
    font-size: 18px;
    font-weight: 400;
  }

  .foot {
    display: grid;
    gap: 22px;
  }

  .pbtns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  :global(.pb) {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 400;
    border: 1px solid transparent;
    transition: transform 0.5s var(--ease), box-shadow 0.5s, background 0.3s, border-color 0.3s;
  }

  :global(.pb svg) {
    width: 17px;
    height: 17px;
    flex: none;
    transition: transform 0.5s var(--ease);
  }

  :global(.pb::after) {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.4) 50%, transparent 65%);
    transform: translateX(-120%);
  }

  :global(.pb:hover) {
    transform: translateY(-2px);
  }

  :global(.pb:hover::after) {
    transform: translateX(120%);
    transition: transform 0.9s var(--ease);
  }

  :global(.pb.p) {
    background: var(--p3);
    color: #fff;
  }

  :global(.pb.p:hover) {
    box-shadow: 0 14px 30px -12px rgba(139, 86, 165, 0.7);
  }

  :global(.pb.s) {
    background: transparent;
    color: var(--ink);
    border-color: var(--line);
  }

  :global(.pb.s:hover) {
    border-color: var(--p1);
    background: color-mix(in srgb, var(--p1) 10%, transparent);
  }

  :global(.pb.s:hover svg) {
    transform: rotate(-8deg) scale(1.1);
  }

  :global(.pb.p:hover svg) {
    transform: translateY(2px);
  }

  .paid :global(.pb.p) {
    background: var(--mist);
    color: #5d3a73;
  }

  .paid :global(.pb.p:hover) {
    box-shadow: 0 14px 30px -12px rgba(46, 34, 55, 0.5);
  }

  .paid :global(.pb.p:hover svg) {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .pi {
      min-height: 340px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi,
    :global(.pb) {
      transition: none !important;
      transform: none !important;
    }
    :global(.pi li path) {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
</style>
