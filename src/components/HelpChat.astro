---
import { EMAIL } from '../data/specialties';
import L from './L.astro';

const questions = [
  {
    id: 'zenith',
    category: 'general',
    es: '¿Qué es Zenith?',
    en: 'What is Zenith?',
    answerEs: 'Zenith es una agencia de desarrollo de software. Resolvemos lo que te frena: tiempo perdido, tareas repetitivas y sistemas que no se conectan. Desarrollamos software especializado para empresas y micro apps generales de pago mensual, próximamente. Nuestro objetivo es ahorrar tiempo y ayudarte a generar más ingresos.',
    answerEn: 'Zenith is a software development agency. We solve what holds you back: lost time, repetitive tasks and systems that do not connect. We build specialized business software and general-purpose monthly subscription micro apps, coming soon. Our goal is to save time and help you grow revenue.',
  },
  {
    id: 'software',
    category: 'general',
    es: '¿Qué tipo de software construyen?',
    en: 'What kind of software do you build?',
    answerEs: 'Software a medida según los requisitos de tu empresa (SaaS, dashboards, inventarios, automatizaciones e integraciones), micro apps generales de pago mensual y páginas web.',
    answerEn: 'Custom software based on your business requirements (SaaS, dashboards, inventory, automations and integrations), general-purpose micro apps with monthly subscriptions, and websites.',
  },
  {
    id: 'price',
    category: 'project',
    es: '¿Cuánto cuesta un proyecto?',
    en: 'How much does a project cost?',
    answerEs: 'El software a medida se cotiza según requisitos y alcance. Las micro apps llegarán próximamente como una opción más económica con pago mensual. Los precios se publicarán cuando estén disponibles.',
    answerEn: 'Custom software is quoted based on requirements and scope. Micro apps are coming soon as a more affordable monthly subscription option. Pricing will be published when available.',
  },
  {
    id: 'time',
    category: 'project',
    es: '¿Cuánto tarda?',
    en: 'How long does it take?',
    answerEs: 'El software a medida requiere análisis de requisitos, desarrollo y entrega; el plazo se acuerda según el alcance. Las micro apps llegarán próximamente y tendrán acceso inmediato al suscribirte.',
    answerEn: 'Custom software requires requirements analysis, development and delivery; timing depends on scope. Micro apps are coming soon and will provide immediate access when you subscribe.',
  },
  {
    id: 'code',
    category: 'general',
    es: '¿Necesito saber programar?',
    en: 'Do I need to know how to code?',
    answerEs: 'No. Nuestro equipo se encarga del código para que tú solo tengas que usar tu software.',
    answerEn: 'No. Our team handles the code so you only have to use your software.',
  },
  {
    id: 'support',
    category: 'project',
    es: '¿Qué incluye el soporte?',
    en: 'What does support include?',
    answerEs: 'El soporte se renueva anualmente. Las páginas web incluyen mantenimiento y hosting; el software a la medida incluye alojamiento premium administrado por Zenith.',
    answerEn: 'Support renews annually. Websites include maintenance and hosting; custom software includes premium hosting managed by Zenith.',
  },
  {
    id: 'microapps',
    category: 'general',
    es: '¿En qué se diferencian las micro apps?',
    en: 'How are micro apps different?',
    answerEs: 'El software especializado se desarrolla según los requisitos de tu empresa y requiere tiempo de análisis y construcción. Las micro apps llegarán próximamente para resolver necesidades generales con funciones definidas, menor costo y acceso inmediato mediante pago mensual.',
    answerEn: 'Specialized software is developed around your business requirements and takes time to analyze and build. Micro apps are coming soon to address common needs with predefined features, lower cost and immediate access through monthly subscriptions.',
  },
];
const categories = [
  { id: 'general', es: 'Conocer Zenith', en: 'About Zenith' },
  { id: 'project', es: 'Mi proyecto', en: 'My project' },
];
---

<div class="help-chat help-chat-enter" data-help-chat>
  <button class="help-chat-bubble" type="button" aria-expanded="false" aria-controls="help-chat-panel">
    <span class="help-chat-bubble-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H12l-4.6 3v-3.1a2.5 2.5 0 0 1-2.4-2.4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 9.5h7M8.5 12h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </span>
    <span class="help-chat-bubble-label"><L es="Ayuda" en="Help" /></span>
  </button>

  <section class="help-chat-panel" id="help-chat-panel" aria-label="Zenith assistant" aria-hidden="true">
    <header class="help-chat-head">
      <div class="help-chat-avatar" aria-hidden="true">Z</div>
      <div>
        <strong>Zenith Assistant</strong>
        <span><i></i><L es="Respuestas instantáneas" en="Instant answers" /></span>
      </div>
      <button class="help-chat-close" type="button" aria-label="Cerrar"><span></span><span></span></button>
    </header>
    <div class="help-chat-body" data-chat-body>
      <div class="help-chat-message bot">
        <p><L es="Hola, soy el asistente de Zenith. Selecciona una pregunta y te orientaré." en="Hi, I am the Zenith assistant. Select a question and I will point you in the right direction." /></p>
      </div>
      <div class="help-chat-progress" aria-live="polite"><span data-chat-progress>1</span>{' '}<L es="de 3 pasos" en="of 3 steps" /></div>
      <div class="help-chat-categories" data-chat-categories>
        {categories.map((category) => (
          <button type="button" data-category={category.id}><span>{category.es}</span><span>{category.en}</span></button>
        ))}
      </div>
      <div class="help-chat-prompts is-hidden" data-chat-prompts>
        {questions.map((question) => (
          <button type="button" data-id={question.id} data-category={question.category} data-es={question.es} data-en={question.en} data-answer-es={question.answerEs} data-answer-en={question.answerEn}>
            <span>{question.es}</span><span>{question.en}</span>
          </button>
        ))}
      </div>
      <a class="help-chat-final" data-chat-final href={`mailto:${EMAIL}?subject=Quiero%20hablar%20sobre%20mi%20proyecto`}><L es="Cuéntanos tu idea →" en="Tell us about your idea →" /></a>
    </div>
    <footer class="help-chat-foot">
      <button type="button" class="help-chat-reset" data-chat-reset><L es="Reiniciar conversación" en="Restart conversation" /></button>
      <span class="help-chat-note"><L es="Respuestas predefinidas" en="Predefined answers" /></span>
    </footer>
  </section>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-help-chat]');
    if (!root) return;
    var bubble = root.querySelector('.help-chat-bubble');
    var panel = root.querySelector('.help-chat-panel');
    var body = root.querySelector('[data-chat-body]');
    var prompts = root.querySelector('[data-chat-prompts]');
    var categories = root.querySelector('[data-chat-categories]');
    var progress = root.querySelector('[data-chat-progress]');
    var final = root.querySelector('[data-chat-final]');
    var close = root.querySelector('.help-chat-close');
    var reset = root.querySelector('[data-chat-reset]');
    var initialBody = body.innerHTML;
    var open = function () {
      root.classList.add('is-open');
      bubble.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      setTimeout(function () { var first = categories.querySelector('button'); if (first) first.focus(); }, 100);
    };
    var shut = function () {
      root.classList.remove('is-open');
      bubble.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      bubble.focus();
    };
    var lang = function () { return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'es'; };
    var text = function (el, key) { return el.getAttribute(key + '-' + lang()) || ''; };
    var addMessage = function (content, type) {
      var item = document.createElement('div');
      item.className = 'help-chat-message ' + type;
      item.innerHTML = '<p>' + content.replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }) + '</p>';
      body.appendChild(item);
      body.scrollTop = body.scrollHeight;
    };
    var ask = function (button) {
      var question = text(button, 'data');
      addMessage(question, 'user');
      prompts.classList.add('is-hidden');
      var thinking = document.createElement('div');
      thinking.className = 'help-chat-message bot thinking';
      thinking.innerHTML = '<p><span></span><span></span><span></span></p>';
      body.appendChild(thinking);
      body.scrollTop = body.scrollHeight;
      window.setTimeout(function () {
        thinking.remove();
        addMessage(text(button, 'data-answer'), 'bot');
        prompts.classList.remove('is-hidden');
        final.classList.add('is-visible');
        if (progress) progress.textContent = '3';
      }, 850);
    };
    var chooseCategory = function (button) {
      var category = button.getAttribute('data-category');
      categories.classList.add('is-hidden');
      prompts.classList.remove('is-hidden');
      prompts.querySelectorAll('button').forEach(function (question) {
        question.hidden = question.getAttribute('data-category') !== category;
      });
      if (progress) progress.textContent = '2';
    };
    var updatePromptLanguage = function () {
      prompts.querySelectorAll('button').forEach(function (button) {
        button.setAttribute('aria-label', text(button, 'data'));
      });
    };
    bubble.addEventListener('click', function () { root.classList.contains('is-open') ? shut() : open(); });
    close.addEventListener('click', shut);
    prompts.querySelectorAll('button').forEach(function (button) { button.addEventListener('click', function () { ask(button); }); });
    categories.querySelectorAll('button').forEach(function (button) { button.addEventListener('click', function () { chooseCategory(button); }); });
    updatePromptLanguage();
    reset.addEventListener('click', function () {
      body.innerHTML = initialBody;
      prompts = root.querySelector('[data-chat-prompts]');
      categories = root.querySelector('[data-chat-categories]');
      progress = root.querySelector('[data-chat-progress]');
      final = root.querySelector('[data-chat-final]');
      prompts.querySelectorAll('button').forEach(function (button) { button.addEventListener('click', function () { ask(button); }); });
      categories.querySelectorAll('button').forEach(function (button) { button.addEventListener('click', function () { chooseCategory(button); }); });
      final.classList.remove('is-visible');
      body.scrollTop = 0;
    });
    document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && root.classList.contains('is-open')) shut(); });
  }());
</script>
