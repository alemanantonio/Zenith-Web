---
const { animated = false, class: cls = '' } = Astro.props;
// High precision geometry scaled to 1000x1000 coordinates (x5):
// Center of rotation: (500, 500)
// Outer disc arc: R=300, center at (300, 300)
// Inner cut arc: R=385, center at (300, 700)
// Exact connection points: (28, 427) to (572, 427)
const d = 'M 28 427 A 300 300 0 1 1 572 427 A 385 385 0 0 0 28 427 Z';
const rots = [0, 90, 180, 270];
---
{animated ? (
  <svg
    class={`mark ${cls}`}
    viewBox="-10 -10 1020 1020"
    role="img"
    aria-label="Zenith"
    shape-rendering="geometricPrecision"
  >
    <g fill="currentColor" stroke="currentColor" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">
      {rots.map((r, i) => (
        <g transform={`rotate(${r} 500 500)`}>
          <path class="petal" style={`--i:${i}`} d={d} />
        </g>
      ))}
    </g>
  </svg>
) : (
  <svg class={cls} aria-hidden="true" shape-rendering="geometricPrecision">
    <use href="#zl" />
  </svg>
)}

