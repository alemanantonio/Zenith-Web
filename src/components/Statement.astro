---
import { site } from '../data/site';
const words = site.statement.trim().split(/\s+/);
---
<section class="statement" id="que-es">
  <p id="statement" data-i18n-statement={site.statement}>
    {words.map((w) => (
      <>
        <span class="w">{w}</span>{' '}
      </>
    ))}
  </p>
</section>

<style>
  .statement {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(120px, 20vw, 240px) 24px clamp(80px, 12vw, 150px);
  }

  .statement p {
    margin: 0;
    font-size: clamp(28px, 5.2vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.015em;
  }

  .statement :global(.w) {
    opacity: 0.72;
    transition: opacity 0.35s;
  }

  .statement :global(.w.lit) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .statement .w {
      opacity: 1 !important;
    }
  }
</style>
