---
import PlanCard from './PlanCard.astro';
import { site } from '../data/site';

const checkmarkPath = "M4 10.5l4 4 8-9";
---
<section class="planes" id="planes">
  <div class="wrap">
    <h2 class="plans-h lm"><span data-i18n="plans.sectionTitle">Dos formas de empezar.</span></h2>
    <div class="plans">
      <!-- Plan Gratuito -->
      <PlanCard
        kind={site.plans.free.kind}
        name={site.plans.free.name}
        price={site.plans.free.price}
        paid={false}
        dataI18nKind="plans.free.kind"
        dataI18nName="plans.free.name"
        dataI18nPrice="plans.free.price"
      >
        <p data-i18n="plans.free.description">{site.plans.free.description}</p>
        <ul>
          {site.plans.free.features.map((feat, i) => (
            <li>
              <svg viewBox="0 0 20 20">
                <path style={`--k:${i}`} pathLength="1" d={checkmarkPath} />
              </svg>
              <span data-i18n={`plans.free.features.${i}`}>{feat}</span>
            </li>
          ))}
        </ul>

        <Fragment slot="actions">
          <a class="pb p" href={site.links.install}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v9m0 0l-4-4m4 4l4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span data-i18n="plans.free.actions.install">{site.plans.free.actions.installText}</span>
          </a>
          <a class="pb s" href={site.links.github} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span data-i18n="plans.free.actions.github">{site.plans.free.actions.githubText}</span>
          </a>
        </Fragment>
      </PlanCard>

      <!-- Plan De Paga -->
      <PlanCard
        kind={site.plans.paid.kind}
        name={site.plans.paid.name}
        price={site.plans.paid.price}
        paid={true}
        dataI18nKind="plans.paid.kind"
        dataI18nName="plans.paid.name"
        dataI18nPrice="plans.paid.price"
      >
        <p data-i18n="plans.paid.description">{site.plans.paid.description}</p>
        <ul>
          {site.plans.paid.features.map((feat, i) => (
            <li>
              <svg viewBox="0 0 20 20">
                <path style={`--k:${i}`} pathLength="1" d={checkmarkPath} />
              </svg>
              <span data-i18n={`plans.paid.features.${i}`}>{feat}</span>
            </li>
          ))}
        </ul>

        <Fragment slot="actions">
          <a class="pb p" href={site.links.request}>
            <span data-i18n="plans.paid.actions.request">{site.plans.paid.actionText}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </Fragment>
      </PlanCard>
    </div>
  </div>
</section>

<style>
  .planes {
    padding: 0 0 clamp(100px, 14vw, 180px);
  }

  .plans-h {
    margin: 0;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .plans {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 48px;
  }

  @media (max-width: 820px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
