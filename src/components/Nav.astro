---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { site } from '../data/site';
---
<nav id="nav">
  <div class="nav-in">
    <a class="brand" href="#top" aria-label="Zenith">
      <Logo class="brand-logo" />
      <span>{site.name.toUpperCase()}</span>
    </a>
    <div class="nav-right">
      <div class="links">
        <a href="#que-es" data-i18n="nav.whatIs">Qué es</a>
        <a href="#principios" data-i18n="nav.principles">Principios</a>
        <a href="#planes" data-i18n="nav.plans">Planes</a>
        <a href="#preguntas" data-i18n="nav.faq">Preguntas</a>
      </div>
      <LangSwitch />
    </div>
  </div>
  <div class="bar" id="bar"></div>
</nav>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    setTimeout(() => {
      nav.classList.add('on');
    }, 50);
  }
</script>

<style>
  nav {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 20;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    transform: translateY(-100%);
    transition: transform 0.9s var(--ease) 2.6s;
  }

  nav.on {
    transform: none;
  }

  .nav-in {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.28em;
    font-size: 14px;
  }

  .brand :global(.brand-logo) {
    width: 22px;
    height: 22px;
    color: var(--p3);
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 13px;
    color: var(--mute);
  }

  .links a {
    transition: color 0.3s;
  }

  .links a:hover {
    color: var(--ink);
  }

  .bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--p1);
    transform: scaleX(var(--sp, 0));
    transform-origin: left;
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
