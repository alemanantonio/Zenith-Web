---
import L from './L.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  variant?: 'home' | 'sub';
}
const { variant = 'home' } = Astro.props;
---
{variant === 'home' ? (
  <nav id="nav"><div class="nav-in">
    <a class="brand" href="#top" aria-label="Zenith"><svg aria-hidden="true"><image href="/favicon.svg" width="100%" height="100%"/></svg><span>ZENITH</span></a>
    <div class="nav-end">
      <div class="links" id="menu">
        <a href="#que-hacemos"><L es="Qué hacemos" en="What we do" /></a>
        <a href="#principios"><L es="Principios" en="Principles" /></a>
        <a href="#proceso"><L es="Proceso" en="Process" /></a>
        <a href="#preguntas"><L es="Preguntas" en="Questions" /></a>
        <a href="#contacto"><L es="Contacto" en="Contact" /></a>
      </div>
      <LangSwitch />
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menú"><span></span><span></span></button>
    </div>
  </div><div class="bar"></div></nav>
) : (
  <nav id="nav2"><div class="nav-in">
    <a class="backbtn" href="/" aria-label="Volver al inicio"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m0 0l4-4m-4 4l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><L es="Inicio" en="Home" /></a>
    <div class="nav-end">
      <LangSwitch />
      <a class="brand" href="/" aria-label="Zenith, ir al inicio"><svg aria-hidden="true"><image href="/favicon.svg" width="100%" height="100%"/></svg><span>ZENITH</span></a>
    </div>
  </div><div class="bar"></div></nav>
)}
