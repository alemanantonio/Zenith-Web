---
import type { InquiryForm } from '../data/inquiryForms';

interface Props {
  form: InquiryForm;
}
const { form } = Astro.props;
const forms = [
  { lang: 'es', ...form.es, link: 'Abrir el formulario completo ↗' },
  { lang: 'en', ...form.en, link: 'Open the full form ↗' },
];
---
<div class="inquiry-form">
  {forms.map((form) => (
    <div class={`l ${form.lang}`} lang={form.lang}>
      <iframe
        src={`${form.url}?embedded=true`}
        title={form.title}
        loading="lazy"
        width="100%"
        height="680"
      />
      <a class="form-link" href={form.url} target="_blank" rel="noopener noreferrer">{form.link}</a>
    </div>
  ))}
</div>

<style>
  .inquiry-form{position:relative;z-index:2;width:100%;min-width:0;max-width:560px;margin:0 auto;text-align:center}
  iframe{display:block;width:100%;height:680px;border:0;border-radius:16px;background:#fff;color-scheme:light}
  .form-link{display:inline-block;margin-top:20px;padding:12px 16px;color:inherit;text-decoration:underline;text-underline-offset:4px;font-size:16px}
  .form-link:focus-visible{outline:2px solid currentColor;outline-offset:4px;border-radius:4px}
</style>
