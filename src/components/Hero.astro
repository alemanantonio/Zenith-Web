---
import Logo from './Logo.astro';
import { site } from '../data/site';
---
<header class="hero" id="top">
  <div class="orb o1"></div>
  <div class="orb o2"></div>
  <div class="ring"></div>
  <div class="ring" style="animation-delay:2.5s"></div>
  <div class="glow" id="glow"></div>
  <div class="stage">
    <div id="par">
      <div class="mark-wrap">
        <Logo animated={true} />
      </div>
    </div>
    <h1 class="word" aria-label={site.name}>
      {site.name.toUpperCase().split('').map((char, i) => (
        <span style={`--i:${i}`}>{char}</span>
      ))}
    </h1>
    <p class="tag" data-i18n="hero.tag">{site.tagline}</p>
    <div class="hero-actions">
      <a class="hero-btn" href="/demo">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M6 4l10 6-10 6V4z" fill="currentColor"/>
        </svg>
        <span data-i18n="hero.tryDemo">Probar</span>
      </a>
    </div>
  </div>
  <div class="cue"></div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    color: #f8f4fa;
    overflow: hidden;
    background: linear-gradient(135deg, #8b56a5 0%, #a276b8 45%, #b998c9 100%);
  }

  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 45%), rgba(255, 255, 255, .22), transparent 60%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .o1 {
    width: 46vmax;
    height: 46vmax;
    background: #b998c9;
    left: -14vmax;
    top: -12vmax;
  }

  .o2 {
    width: 38vmax;
    height: 38vmax;
    background: #8b56a5;
    right: -12vmax;
    bottom: -14vmax;
    animation-duration: 24s;
  }

  @keyframes drift {
    to {
      transform: translate3d(6vmax, 4vmax, 0) scale(1.15);
    }
  }

  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
    animation: pulse 5s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      width: 140px;
      height: 140px;
      opacity: 0;
    }
    15% {
      opacity: 0.7;
    }
    100% {
      width: min(120vmax, 1400px);
      height: min(120vmax, 1400px);
      opacity: 0;
    }
  }

  .stage {
    position: relative;
    z-index: 2;
    padding: 0 24px;
  }

  .mark-wrap {
    width: clamp(120px, 19vw, 176px);
    margin: 0 auto;
  }

  :global(.mark) {
    display: block;
    width: 100%;
    height: auto;
    color: #f8f4fa;
    animation: spin 70s linear 2.4s infinite;
    filter: drop-shadow(0 8px 32px rgba(60, 20, 90, 0.28));
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  :global(.petal) {
    transform-box: view-box;
    transform-origin: 500px 500px;
    opacity: 0;
    animation: petal 1.5s var(--ease) calc(0.2s + var(--i) * 0.14s) both;
  }

  @keyframes petal {
    from {
      opacity: 0;
      transform: rotate(-80deg) scale(0.35);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .word {
    display: flex;
    justify-content: center;
    margin: 42px 0 0;
    font-weight: 200;
    font-size: clamp(40px, 9vw, 92px);
    letter-spacing: 0.22em;
    padding-left: 0.22em;
    line-height: 1;
  }

  .word span {
    display: inline-block;
    opacity: 0;
    transform: translateY(40%);
    filter: blur(10px);
    animation: rise 1.4s var(--ease) both;
    animation-delay: calc(1.4s + var(--i) * 0.09s);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .tag {
    margin: 26px 0 0;
    font-size: clamp(16px, 2.2vw, 21px);
    opacity: 0;
    animation: fade 1.6s ease 2.3s forwards;
  }

  .hero-actions {
    margin-top: 32px;
    opacity: 0;
    animation: fade 1.6s ease 2.5s forwards;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 32px;
    border-radius: 999px;
    background: #ffffff;
    color: #5d3a73;
    font-size: 15.5px;
    font-weight: 500;
    box-shadow: 0 12px 36px -8px rgba(46, 34, 55, 0.45);
    transition: transform 0.35s var(--ease), box-shadow 0.35s, background 0.3s;
  }

  .hero-btn svg {
    width: 14px;
    height: 14px;
    color: var(--p3);
  }

  .hero-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 18px 45px -10px rgba(46, 34, 55, 0.6);
    background: #fdfafd;
  }

  .hero-btn:active {
    transform: translateY(0) scale(1);
  }

  @keyframes fade {
    to {
      opacity: 0.92;
    }
  }

  .cue {
    position: absolute;
    bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    width: 1px;
    height: 46px;
    background: linear-gradient(rgba(255, 255, 255, 0.8), transparent);
    transform-origin: top;
    opacity: 0;
    animation: cue 2.4s ease-in-out 3s infinite;
  }

  @keyframes cue {
    0% {
      opacity: 0;
      transform: scaleY(0);
    }
    40% {
      opacity: 1;
      transform: scaleY(1);
    }
    100% {
      opacity: 0;
      transform: scaleY(1) translateY(16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero *,
    .hero *::before,
    .hero *::after {
      animation: none !important;
      transition: none !important;
    }

    .mark-wrap,
    .word span,
    :global(.mark) {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .tag {
      opacity: 0.92;
    }

    :global(.petal) {
      opacity: 1;
      transform: none;
    }
  }
</style>
